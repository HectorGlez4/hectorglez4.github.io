---
/**
 * Kit Diario de Publicación — FR-21, UJ-5.
 *
 * Una dirección que Héctor abre por la mañana en el móvil y encuentra el material del día
 * ya compuesto: la Imagen, el pie de atribución listo para copiar y el enlace.
 *
 * No es una superficie del sitio y no debe llegar a serlo: `noindex`, fuera del sitemap y
 * sin ningún enlace desde la navegación pública. Es la misma condición que la herramienta
 * de curación — algo que existe en el dominio pero no forma parte de lo que se publica.
 *
 * Se compone en el build, así que la reconstrucción diaria de AD-12 la deja hecha sin que
 * nadie intervenga: la misma ejecución que mueve la Cita del Día de la portada mueve esta.
 *
 * El marcado del material vive en `MaterialParaPublicar.astro` desde la Historia 13.1,
 * compartido con `/lote`: los dos derivan los mismos datos de `materialDelKit`, y compartir
 * también la vista es lo que impide que enseñen cosas distintas.
 */
import Armazon from '../components/Armazon.astro';
import MaterialParaPublicar from '../components/MaterialParaPublicar.astro';
import portada from '../../corpus/portada.json';
import { aptasParaPortada, jornadaDelBuild } from '../lib/citaDelDia.ts';
import { materialDelKit } from '../lib/kit.ts';
import { tituloDe } from '../lib/marca.ts';
import { fijacionesDeclaradas } from '../lib/portada.ts';
import { conjuntoPublicable } from '../lib/publicado.ts';

const conjunto = await conjuntoPublicable();
const jornada = jornadaDelBuild(process.env, new Date());
// El fichero se puede editar a mano y ningún esquema lo juzga: se lee por el único lector
// del sitio, que descarta lo que no entiende en vez de tumbar el build (Historia 13.1).
const fijaciones = fijacionesDeclaradas(portada);
const material = materialDelKit(aptasParaPortada(conjunto.citas), jornada, fijaciones);

const autorDe = (slug: string) => conjunto.autores.find((a) => a.slug === slug)!;

const delDia = material && { cita: material.delDia.cita, autor: autorDe(material.delDia.cita.autor) };
const alternativa = material?.alternativa
  ? { cita: material.alternativa.cita, autor: autorDe(material.alternativa.cita.autor) }
  : null;

/** Las jornadas fijadas que quedan por delante, para saber si hay lote que mirar. */
const porDelante = Object.keys(fijaciones).filter((j) => j > jornada).length;
---

<Armazon
  titulo={tituloDe('Kit del día')}
  descripcion="Material del día para publicar en las cuentas."
  ruta="/kit/"
>
  <div class="pagina contenedor">
    <h1>Kit del {jornada}</h1>

    {material === null && <p class="aviso">Hoy no hay ninguna Cita apta para portada.</p>}

    {delDia && <MaterialParaPublicar cita={delDia.cita} autor={delDia.autor} titulo="La Cita del Día" />}

    {
      alternativa && (
        <MaterialParaPublicar
          cita={alternativa.cita}
          autor={alternativa.autor}
          titulo="Alternativa con Imagen"
          esAlternativa
        />
      )
    }

    {/*
      * El paso al lote, y de vuelta desde él. Son la misma herramienta en dos momentos —hoy
      * y los días que vienen—, y las dos son superficies ajenas al producto: este enlace no
      * las hace alcanzables desde la navegación pública, porque a esta página tampoco llega
      * ninguno. Sin él, la única forma de pasar de una a otra es teclear la dirección.
      */}
    <p class="paso">
      {
        porDelante === 0
          ? 'No hay ninguna jornada preparada por delante.'
          : `Hay ${porDelante} ${porDelante === 1 ? 'jornada preparada' : 'jornadas preparadas'} por delante.`
      }{' '}
      <a href="/lote/" data-enlace-lote>Ver el lote</a>
    </p>
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  h1 {
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tinta-apagada);
  }

  .aviso {
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    color: var(--tinta);
  }

  .paso {
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    margin-top: calc(var(--unidad) * 4);
    padding-top: calc(var(--unidad) * 2);
    border-top: var(--grosor-filete) solid var(--filete);
  }
</style>
