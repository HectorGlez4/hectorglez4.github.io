---
/**
 * Página de Cita — FR-1, FR-2. La superficie principal y la unidad atómica de tráfico.
 *
 * El grueso del tráfico entra aquí desde un buscador, en móvil, sin haber visto la
 * portada. Por eso la Cita es lo primero visible sin desplazar en 360×640 y todo lo demás
 * viene después.
 *
 * AD-11 — las rutas salen del dueño del conjunto publicable, nunca de `getCollection`
 * directamente. Una Cita en `corpus/_revision/` no está en ese conjunto, así que no se
 * genera su página y visitarla da 404 sin necesidad de comprobar nada.
 */
import Armazon from '../../components/Armazon.astro';
import BloqueDeCita from '../../components/BloqueDeCita.astro';
import Fuente from '../../components/Fuente.astro';
import TarjetaDeObra from '../../components/TarjetaDeObra.astro';
import CopiarCita from '../../islands/CopiarCita.astro';
import ImagenDeCita from '../../islands/ImagenDeCita.astro';
import FilaDeAcciones from '../../components/FilaDeAcciones.astro';
import CompartirEnlace from '../../islands/CompartirEnlace.astro';
import RutasDeSalida from '../../components/RutasDeSalida.astro';
import DatosEstructurados from '../../components/DatosEstructurados.astro';
import FiltrosDeLaCita from '../../components/FiltrosDeLaCita.astro';
import Desplegable from '../../components/Desplegable.astro';
import ComoCitar from '../../components/ComoCitar.astro';
import InsertaEstaCita from '../../components/InsertaEstaCita.astro';
import LeeElPasaje from '../../components/LeeElPasaje.astro';
import EstiloDeLeeElPasaje from '../../components/EstiloDeLeeElPasaje.astro';
import { citaTieneComoCitar, fragmentoParaInsertar, referenciasDeCita } from '../../lib/atribucion.ts';
import {
  citasDeLasObras,
  citasDeTema,
  conjuntoPublicable,
  filtrosDeLaBusqueda,
  pasajesDeLasCitas,
  rutasDeSalidaDeCita,
  siguienteCita,
  temasPublicados,
} from '../../lib/publicado.ts';
import { tituloDe } from '../../lib/marca.ts';
import type { GetStaticPaths } from 'astro';
import { rutaDeCita } from '../../lib/superficies.ts';
import { clavesDeOrden } from '../../lib/obras.ts';
import { enUnaLinea } from '../../lib/verso.ts';

export const getStaticPaths = (async () => {
  const conjunto = await conjuntoPublicable();
  const autores = new Map(conjunto.autores.map((a) => [a.slug, a]));
  const publicados = temasPublicados(conjunto.temas, conjunto.citas);
  /*
   * Historia 24.5 — «Siguiente…» de la Tarjeta de Obra. Lo decide `siguienteCita`, con los
   * mismos dueños que pintan los dos listados que sigue: el orden del libro de
   * `citasDeLasObras` (la Página de Obra) y `citasDeTema` (la Página de Tema), calculados una
   * vez para todas las Citas y no por página.
   */
  const porObra = await citasDeLasObras(conjunto);
  const listados = new Map(publicados.map((tema) => [tema.slug, citasDeTema(conjunto.citas, tema.slug)]));
  /*
   * Historia 27.1 — los filtros de Pagefind de cada Cita y su clave de orden, calculados una vez
   * para todas: los filtros, de la misma función que compone las opciones de `/buscar/`
   * (`filtrosDeLaBusqueda`); la clave, de `clavesDeOrden` sobre el mismo orden del libro
   * (`porObra`) que pinta la Página de Obra. Una clave que no cabe rompe aquí el build.
   */
  const { porCita } = filtrosDeLaBusqueda(conjunto);
  const claves = clavesDeOrden(conjunto.autores, conjunto.citas, porObra);
  /*
   * Historia 31.2 — el pasaje de cada Cita, de la aparición que cuenta (`aparicionQueCuenta`, la
   * misma que la ordena en el libro), calculado una vez para todas. Esta página es la única que
   * lo lee: ni la portada, ni el 404, ni la Página de Obra, ni ninguna tarjeta lo pintan.
   */
  const pasajes = await pasajesDeLasCitas(conjunto);

  return conjunto.citas.map((cita) => {
    const siguiente = siguienteCita(cita, porObra, publicados, listados);
    const filtros = porCita.get(cita.slug);
    const clave = claves.get(cita.slug);
    if (filtros === undefined || clave === undefined) {
      throw new Error(
        `La Cita «${cita.slug}» no tiene ${filtros === undefined ? 'filtros de búsqueda' : 'clave de orden'}: ` +
          'filtrosDeLaBusqueda y clavesDeOrden tienen que cubrir todas las Citas publicadas (Historia 27.1).',
      );
    }
    return {
      params: { slug: cita.slug },
      props: {
        cita,
        autor: autores.get(cita.autor)!,
        siguiente,
        /*
         * Historia 24.6 — las Rutas de salida del pie: «De la misma obra», «Más de {Autor}» y
         * los Temas. Las decide `rutasDeSalidaDeCita` con el mismo `porObra` y el mismo
         * `siguiente` que la tarjeta, para que ninguna repita la Cita que «Siguiente» ya ofrece.
         */
        rutas: rutasDeSalidaDeCita(cita, conjunto.citas, porObra, publicados, siguiente),
        filtros,
        clave,
        pasaje: pasajes.get(cita.slug),
      },
    };
  });
}) satisfies GetStaticPaths;

const { cita, autor, siguiente, rutas, filtros, clave, pasaje } = Astro.props;

/**
 * El título de pestaña y la meta descripción llevan la Cita entera si cabe. Quien llega
 * desde un buscador decide si entrar leyendo esto, así que recortarlo con puntos
 * suspensivos donde no hace falta cuesta clics.
 */
/*
 * Ninguno de los dos admite saltos: el verso va en una línea, con « / » (`enUnaLinea`, Historia
 * 29.3). El recorte se mide sobre el texto —cada salto, un carácter— y en el mismo índice de
 * siempre; si cae en o junto a un salto, la racha final que lo contiene se quita para que ni el
 * salto ni « / » queden colgando antes de «…». Una Cita sin saltos no cambia ni un byte.
 */
const recorte =
  cita.texto.length > 110
    ? `${enUnaLinea(cita.texto.slice(0, 109).replace(/\s*\n\s*$/, ''))}…`
    : enUnaLinea(cita.texto);
const titulo = tituloDe(`«${recorte}» — ${autor.nombre}`);
const canonica = new URL(rutaDeCita(cita.slug), Astro.site).href;
---

<Armazon
  titulo={titulo}
  descripcion={`${enUnaLinea(cita.texto)} — ${autor.nombre}.`}
  ruta={rutaDeCita(cita.slug)}
  tarjeta={`/tarjeta/${cita.slug}.png`}
  tipo="cita"
>
  <DatosEstructurados slot="cabeza" cita={cita} autor={autor} canonica={canonica} />
  {/* Historia 31.2 — la presentación del pasaje, solo donde se pinta: sin él, ni un byte más. */}
  {pasaje !== undefined && <EstiloDeLeeElPasaje slot="cabeza" />}
  <article class="pagina contenedor">
    <BloqueDeCita cita={cita} autor={autor} comoTitulo />
    {/*
      * Va aquí y no dentro de `BloqueDeCita` a propósito: ese bloque lo comparten la
      * portada y esta página, y la Cita del Día no es una superficie de comprobación —el
      * documento debajo del titular de la portada sería aparato en el sitio donde menos
      * pinta—. La Página de Cita sí: es la canónica, y a la que llega quien viene a
      * verificar una atribución.
      */}
    <Fuente cita={cita} />
    {/*
      * Historia 30.1 — nada se intercala entre la Atribución —con su Línea de la Fuente— y
      * Copiar: a 360 × 640 la Tarjeta de Obra empujaba Copiar entre 661 y 756 px, fuera de la
      * primera pantalla, y quien viene a llevarse la Cita tenía que pasar antes por la Obra
      * (SM-C5). Primero lo que se hace con la Cita —Copiar, Imagen, compartir— y después la
      * Tarjeta de Obra (UX-DR113, UX-DR122). Desde la 30.2 Copiar e Imagen van en la Fila de
      * acciones —en fila desde 600 px, apilados por debajo (UX-DR114, UX-DR123)—, y «Compartir
      * en» queda fuera, detrás, en su bloque propio.
      */}
    <FilaDeAcciones>
      <CopiarCita cita={cita} autor={autor} />
      <ImagenDeCita cita={cita} autor={autor} />
    </FilaDeAcciones>
    <CompartirEnlace cita={cita} autor={autor} canonica={canonica} />
    {/*
      * Historia 24.4, movida tras compartir por la 30.1 — la Obra de la que sale la Cita. Aquí
      * y no en `BloqueDeCita` por lo mismo que la Fuente: la portada y el 404 no cambian (la Cita
      * del Día nace en este orden con la 28.2). Sin Obra no pinta nada, y las Rutas de salida
      * siguen a compartir. Desde la 24.5 lleva además «Siguiente…» cuando hay a dónde ir
      * (`siguiente`, decidido arriba).
      */}
    <TarjetaDeObra cita={cita} autor={autor} nivel={2} siguiente={siguiente} />
    {/*
      * Historia 30.3 — el bloque de desplegables, tras la Tarjeta de Obra —o tras compartir, sin
      * Obra— y antes de las Rutas de salida (UX-DR119). Es **un solo sitio** a propósito: la
      * palanca de SM-C5 es un diff de aquí. Lleva «Cómo citar» —si la Cita lo tiene— y, el último,
      * «Inserta esta cita» (30.4). Delante va «Lee el pasaje» (31.2), solo si la Cita tiene
      * pasaje y sin hueco reservado si no. Desde la 30.4 el bloque se pinta siempre: el Fragmento
      * existe para toda Cita. Fuera de Pagefind (`all`): el pasaje, las Referencias y el Fragmento
      * repiten el texto, el título y el Autor —o dicen lo que la Cita no dice—, y la página no se
      * encuentra por ellos; fuera del JSON-LD. Sin `data-zona`: el único enlace es el de salida a
      * la edición, en el pasaje; la canónica es texto de las Referencias y del campo.
      */}
    <div class="desplegables" data-pagefind-ignore="all">
      {pasaje !== undefined && (
        <Desplegable rotulo="Lee el pasaje"><LeeElPasaje pasaje={pasaje} fuente={cita.fuente} slug={cita.slug} /></Desplegable>
      )}
      {citaTieneComoCitar(cita) && (
        <Desplegable rotulo="Cómo citar"><ComoCitar referencias={referenciasDeCita(cita, autor, canonica)} /></Desplegable>
      )}
      <Desplegable rotulo="Inserta esta cita"><InsertaEstaCita fragmento={fragmentoParaInsertar(cita, autor, canonica)} /></Desplegable>
    </div>
    {/*
      * Historia 24.6 — tras las acciones, los tres grupos del pie. Un grupo sin Citas no pinta
      * nada, y sin ninguno no hay `nav`: la Atribución sigue enlazando al Autor y a la Obra.
      */}
    <RutasDeSalida autor={autor} rutas={rutas} zona="rutas-de-salida" />
    {/*
      * Historia 27.1 — lo que la Cita declara a Pagefind: sus filtros, su metadato `autor` y su
      * clave de orden. El último hijo de `<article>`, fuera de todo bloque que se repite en otra
      * página; lo escribe solo este componente.
      */}
    <FiltrosDeLaCita filtros={filtros} clave={clave} nombreDelAutor={autor.nombre} />
  </article>
</Armazon>

<style>
  .pagina {
    /*
     * La respiración por encima del bloque es lo que comunica que esto es una antología
     * y no un listado. En móvil se queda en 40px: más aire empujaría la Cita fuera de la
     * primera pantalla de 360×640, que es justo lo que FR-1 prohíbe.
     */
    padding-block: var(--respiracion);
  }

  /* Historia 30.3 — el primer filete a 4 × unidad de la Tarjeta de Obra o de «Compartir en». */
  .desplegables {
    margin-top: calc(var(--unidad) * 4);
  }
</style>
