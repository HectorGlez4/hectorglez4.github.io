---
/**
 * Página de Personaje — Historia 35.3, UX-DR134.
 *
 * Calca la Página de Autor: la Ficha —solo en la página 1— y todas las Citas publicadas que el
 * Personaje dice. Un Personaje sin Citas publicadas no tiene página: `personajesPublicados` no lo
 * devuelve, así que no se genera ruta. Con el Corpus de hoy, sin Personajes, la página no
 * construye ninguna ruta.
 *
 * Lo que la separa de la de Autor: «personaje de {universo}» donde van los años; la semblanza,
 * propia o de una biografía, **siempre** fuera de Pagefind y con su atribución visible; el rótulo
 * «Citas» y sin `Person` en el JSON-LD. Desde la 35.5, «Buscar en {Personaje}» en la página 1, bajo
 * «Citas» y encima del listado, como «Buscar en {Autor}»: lleva a `/buscar/?personaje=`. Su Tarjeta Social (35.3b) es la
 * de listado, `/tarjeta/personaje/{slug}.png`, en todas sus páginas.
 * Las 2+ llevan el `h1` y el listado, y son `noindex` por forma (`superficies.ts`).
 */
import Armazon from '../../../components/Armazon.astro';
import DatosDePersonaje from '../../../components/DatosDePersonaje.astro';
import Paginacion from '../../../components/Paginacion.astro';
import TarjetaDeCita from '../../../components/TarjetaDeCita.astro';
import AtribucionDeSemblanza from '../../../components/AtribucionDeSemblanza.astro';
import ListaDeObras from '../../../components/ListaDeObras.astro';
import Desplegable from '../../../components/Desplegable.astro';
import Rotulo from '../../../components/Rotulo.astro';
import BuscarEn from '../../../components/BuscarEn.astro';
import { rotuloBuscarEnPersonaje } from '../../../lib/busqueda.ts';
import {
  citasDePersonaje,
  conjuntoPublicable,
  obrasDelPersonaje,
  personajesPublicados,
  type Cita,
} from '../../../lib/publicado.ts';
import {
  descripcionDePersonaje,
  semblanzaEn,
  universoDePersonaje,
} from '../../../lib/atribucion.ts';
import { CITAS_POR_PAGINA } from '../../../lib/umbrales.ts';
import { tituloDePersonaje } from '../../../lib/marca.ts';
import type { GetStaticPaths } from 'astro';
import { rutaDePersonaje } from '../../../lib/superficies.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const conjunto = await conjuntoPublicable();

  return personajesPublicados(conjunto.personajes, conjunto.citas).flatMap((personaje) => {
    const suyas = citasDePersonaje(conjunto.citas, personaje.slug);
    return paginate(suyas, {
      params: { slug: personaje.slug },
      props: {
        personaje,
        total: suyas.length,
        // La Lista de Obras: solo la pinta la página 1, como en la de Autor.
        susObras: obrasDelPersonaje(conjunto.citas, personaje.slug),
      },
      pageSize: CITAS_POR_PAGINA,
    });
  });
}) satisfies GetStaticPaths;

const { personaje, total, susObras } = Astro.props;
const pagina = Astro.props.page as import('astro').Page<Cita>;

const ruta = rutaDePersonaje(personaje.slug, pagina.currentPage);
const canonica = new URL(ruta, Astro.site).href;
const primera = pagina.currentPage === 1;

/*
 * La semblanza, solo en la Ficha de la página 1 y donde se porta su atribución (AD-28,
 * `src/lib/atribucion.ts`): la de una biografía con `AtribucionDeSemblanza`, la propia con
 * «Semblanza de {responde}.». Siempre fuera de Pagefind.
 */
const semblanza = primera ? semblanzaEn(personaje, 'ficha-de-personaje') : undefined;
const atribucion =
  personaje.atribucion !== undefined
    ? personaje.atribucion
    : personaje.responde !== undefined
      ? { responde: personaje.responde }
      : undefined;

/* Al pie de la Lista de Obras, cuántas Citas no declaran obra, como en la de Autor. */
const conLista = susObras.obras.length > 0;
const pieDeObras =
  susObras.sinObra === 0
    ? undefined
    : susObras.sinObra === 1
      ? `${conLista ? 'Y una' : 'Una'} cita sin obra documentada.`
      : `${conLista ? 'Y ' : ''}${susObras.sinObra} citas sin obra documentada.`;
---

<Armazon
  titulo={tituloDePersonaje(personaje.nombre, pagina.currentPage)}
  descripcion={descripcionDePersonaje(personaje, total, pagina.currentPage)}
  ruta={ruta}
  tarjeta={`/tarjeta/personaje/${personaje.slug}.png`}
  tipo="personaje"
>
  <DatosDePersonaje
    slot="cabeza"
    citas={pagina.data}
    canonica={canonica}
    tramo={{ actual: pagina.currentPage, porPagina: CITAS_POR_PAGINA }}
  />
  <div class="pagina contenedor">
    <header class="ficha">
      <h1>{personaje.nombre}</h1>
      {primera && <p class="universo">{universoDePersonaje(personaje)}</p>}
      {
        semblanza !== undefined && (
          <div data-pagefind-ignore>
            <p class="semblanza">{semblanza}</p>
            {atribucion !== undefined && <AtribucionDeSemblanza atribucion={atribucion} />}
          </div>
        )
      }
    </header>

    {
      primera && (conLista || pieDeObras !== undefined) && (
        <section class="obras-del-personaje" aria-labelledby="sus-obras" data-pagefind-ignore>
          <Rotulo id="sus-obras">Obras en este Corpus</Rotulo>
          <ListaDeObras obras={susObras.obras} zona="lista-de-obras" pliegue={Desplegable} />
          {pieDeObras !== undefined && <p class="sin-obra">{pieDeObras}</p>}
        </section>
      )
    }

    <h2 class="rotulo">Citas</h2>

    {
      /*
       * Historia 35.5, UX-DR134 — «Buscar en {Personaje}», solo en la página 1, con los ritmos de
       * «Buscar en {Autor}»: a 2 × `--unidad` del rótulo, y el listado 3 × más abajo.
       */
      primera && (
        <BuscarEn id="buscar-en-el-personaje" rotulo={rotuloBuscarEnPersonaje(personaje.nombre)} filtros={{ personaje: personaje.slug }} />
      )
    }

    {/* Cada tarjeta lleva el título de su Obra (`atribucion="obra"`), como en la de Autor. */}
    <ul class="listado">
      {pagina.data.map((cita) => <TarjetaDeCita cita={cita} atribucion="obra" zona="listado" />)}
    </ul>

    <Paginacion pagina={pagina} zona="paginacion" />
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  .ficha {
    max-width: var(--medida-prosa);
  }

  h1 {
    /* La serif se aplica al nombre de Personaje, como al de Autor. */
    font-family: var(--serif);
    font-size: var(--titular-md);
    font-weight: var(--peso-fuerte);
    line-height: var(--interlineado-titular-md);
    margin: 0;
  }

  /* Donde la de Autor lleva sus años, con su trato. */
  .universo {
    margin: var(--unidad) 0 0;
    font-size: var(--pie);
    color: var(--tinta-apagada);
  }

  .semblanza {
    margin: calc(var(--unidad) * 2) 0 0;
    font-size: var(--cuerpo-lg);
    max-width: var(--medida-prosa);
  }

  .obras-del-personaje {
    margin-top: calc(var(--unidad) * 5);
    max-width: var(--medida-prosa);
  }

  .obras-del-personaje > :global(.lista-de-obras) {
    margin-top: calc(var(--unidad) * 2);
  }

  .sin-obra {
    margin: calc(var(--unidad) * 2) 0 0;
    font-family: var(--sans);
    font-size: var(--pie);
    color: var(--tinta-apagada);
  }

  .rotulo {
    margin: calc(var(--unidad) * 5) 0 0;
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: var(--peso-fuerte);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .listado {
    list-style: none;
    margin: calc(var(--unidad) * 2) 0 0;
    padding: 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }

  /* Historia 35.5 — «Buscar en {Personaje}», a 2 × `--unidad` del rótulo, como en la de Autor. */
  .pagina > :global(.buscar-en) {
    margin-top: calc(var(--unidad) * 2);
  }

  /* En la página 1, el listado empieza 3 × `--unidad` bajo «Buscar en {Personaje}». */
  :global(.buscar-en) + .listado {
    margin-top: calc(var(--unidad) * 3);
  }
</style>
