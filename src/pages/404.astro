---
/**
 * Página 404 — FR-12 en su versión extrema, UX-DR20.
 *
 * «Un 404 es una oportunidad de entrada, no un muro.» Quien llega aquí venía de un enlace
 * roto o de una URL antigua, y casi siempre desde fuera: es tan primera página como
 * cualquier otra, así que lleva lo mismo que la portada — el campo de búsqueda y la Cita
 * del Día.
 *
 * Sin texto de error técnico. Ni el código, ni «la página solicitada no existe», ni nada
 * que suene a registro de servidor. El visitante ya sabe que algo no salió; lo que
 * necesita es por dónde seguir.
 */
import Armazon from '../components/Armazon.astro';
import CitaDelDia from '../components/CitaDelDia.astro';
import Sostener from '../components/Sostener.astro';
import portada from '../../corpus/portada.json';
import { aptasParaPortada, citaDelDia, jornadaDelBuild } from '../lib/citaDelDia.ts';
import { modelosEnRuta } from '../lib/ingreso.ts';
import { tituloDe } from '../lib/marca.ts';
import { conjuntoPublicable, temasPublicados } from '../lib/publicado.ts';
import { rutaDeTema } from '../lib/superficies.ts';

const conjunto = await conjuntoPublicable();
const temas = temasPublicados(conjunto.temas, conjunto.citas);

const jornada = jornadaDelBuild(process.env, new Date());
const seleccion = citaDelDia(aptasParaPortada(conjunto.citas), jornada, portada.fijaciones);
const autorDelDia = seleccion
  ? conjunto.autores.find((a) => a.slug === seleccion.cita.autor)
  : undefined;
---

<Armazon
  titulo={tituloDe('Esa página no está aquí')}
  descripcion="La página que buscabas no está. Busca una cita o empieza por la de hoy."
  ruta="/404"
>
  <div class="pagina contenedor">
    <h1>Esa página no está aquí.</h1>
    <p class="entrada">Puede que el enlace fuera antiguo. Busca la frase que te trajo.</p>

    <form class="formulario" role="search" action="/buscar/" method="get">
      <label for="consulta">Escribe un fragmento, un autor o un tema.</label>
      <input
        id="consulta"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Por ejemplo: no hay camino"
      />
    </form>

    {
      seleccion && autorDelDia && (
        /* Historia 26.8 — el bloque, y su marca de lo que rota, los pinta un solo componente. */
        <CitaDelDia cita={seleccion.cita} autor={autorDelDia} />
      )
    }

    {
      temas.length > 0 && (
        <section>
          <h2>Temas</h2>
          {/*
            * Historia 23.7 — exentos de zona, por escrito (UX-DR111, `chips-del-404` de
            * `EXENCIONES_DE_ZONA`): la tabla de zonas de EXPERIENCE.md no los nombra, y una zona
            * nueva cambiaría el vocabulario —la huella de AD-14 y otro despliegue del receptor—. Se
            * revisa en la pasada de métricas.
            */}
          <ul class="chips" data-sin-zona="chips-del-404">
            {temas.map((tema) => (
              <li>
                <a class="chip" href={rutaDeTema(tema.slug)}>
                  {tema.nombre}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /*
       * La invitación a sostener el sitio — Historia 14.2, UX-DR36.
       *
       * Va después de las salidas, y por el mismo motivo por el que esta página las lleva:
       * quien llega aquí venía de un enlace roto y lo primero que necesita es por dónde
       * seguir. La invitación es lo último, debajo del filete, para quien la busque.
       *
       * Quien decide es `modelosEnRuta` —encendido **y** admitido aquí—, no esta
       * página. Con todo apagado no se emite nada, ni contenedor ni marca (UX-DR35).
       */
      modelosEnRuta(Astro.url.pathname).map(
        (modelo) => modelo.destino !== undefined && <Sostener id={modelo.id} href={modelo.destino} />,
      )
    }
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  h1 {
    /* Inter, no serif: no es una Cita, ni un Autor, ni un Tema. */
    font-family: var(--sans);
    font-size: var(--titular-md);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .entrada {
    margin: calc(var(--unidad) * 2) 0 0;
    max-width: var(--medida-prosa);
  }

  .formulario {
    margin-top: calc(var(--unidad) * 4);
    max-width: var(--medida-prosa);
  }

  label {
    display: block;
    font-size: var(--pie);
    color: var(--tinta-apagada);
    margin-bottom: var(--unidad);
  }

  /* UX-DR10 — el mismo campo que la página de búsqueda: filete inferior que pasa a 2px
     siena al recibir foco, sin caja y sin icono decorativo. */
  input {
    width: 100%;
    min-height: var(--zona-de-toque);
    font-family: var(--serif);
    font-size: var(--titular-sm);
    color: var(--tinta);
    background: transparent;
    border: 0;
    border-bottom: var(--grosor-filete) solid var(--contorno);
    border-radius: 0;
    padding: var(--unidad) 0;
    transition: border-color 150ms;
  }

  /* Historia 22.10 — el filete se suma al anillo global de UX-DR23; no lo sustituye. */
  input:focus {
    border-bottom: 2px solid var(--siena);
  }

  section {
    margin-top: calc(var(--unidad) * 6);
  }

  h2 {
    margin: 0 0 calc(var(--unidad) * 3);
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  /* La Cita del Día (su rótulo y «Ver esta cita» los estiliza `CitaDelDia.astro`). */
  .pagina > :global(.del-dia) {
    margin-top: calc(var(--unidad) * 6);
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--unidad);
    margin: 0;
    padding: 0;
  }

  .chip {
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    padding-inline: calc(var(--unidad) * 2);
    background: var(--contenedor);
    border-radius: var(--radio-tarjeta);
    font-family: var(--serif);
    font-size: var(--cuerpo-md);
    color: var(--tinta);
    text-decoration: none;
    /* NFR-8, Historia 26.9 — el nombre del chip es del Corpus: con el texto al 200 % una palabra
     * más ancha que la columna se parte. El chip es un elemento flexible y `break-word` no rebaja
     * su ancho mínimo; `anywhere` sí. */
    overflow-wrap: anywhere;
  }
</style>
