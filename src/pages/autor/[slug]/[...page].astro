---
/**
 * Página de Autor — FR-4, FR-5.
 *
 * Semblanza breve más todas las Citas publicadas del Autor. Un Autor sin Citas publicadas
 * no tiene página: `autoresPublicados` no lo devuelve, así que no se genera ruta y su URL
 * da 404 (FR-4). No hay ninguna comprobación que hacer aquí — la ausencia es estructural.
 *
 * La paginación de FR-5 vive en esta misma ruta: `[...page]` deja la primera página en
 * `/autor/{slug}` y las siguientes en `/autor/{slug}/2`. Separarlas en dos ficheros
 * obligaría a repetir el listado y a mantenerlos sincronizados.
 *
 * El parámetro se llama `page` en inglés, contra la convención del proyecto, porque
 * `paginate()` de Astro lo exige por nombre. No aparece en ninguna URL —el segmento
 * público es el número—, así que la convención se mantiene donde importa: en las rutas
 * que ve el visitante y en los identificadores del dominio.
 */
import Armazon from '../../../components/Armazon.astro';
import DatosDeAutor from '../../../components/DatosDeAutor.astro';
import Paginacion from '../../../components/Paginacion.astro';
import TarjetaDeCita from '../../../components/TarjetaDeCita.astro';
import AtribucionDeSemblanza from '../../../components/AtribucionDeSemblanza.astro';
import ListaDeObras from '../../../components/ListaDeObras.astro';
import {
  autoresPublicados,
  citasDeAutor,
  citasDocumentadasDeAutor,
  conjuntoPublicable,
  obrasDelAutor,
  type Cita,
} from '../../../lib/publicado.ts';
import { añosDeAutor, descripcionDeAutor, semblanzaEn } from '../../../lib/atribucion.ts';
import { CITAS_POR_PAGINA } from '../../../lib/umbrales.ts';
import { tituloDeAutor } from '../../../lib/marca.ts';
import type { GetStaticPaths } from 'astro';
import { rutaDeAutor } from '../../../lib/superficies.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const conjunto = await conjuntoPublicable();

  return autoresPublicados(conjunto.autores, conjunto.citas).flatMap((autor) =>
    paginate(citasDeAutor(conjunto.citas, autor.slug), {
      params: { slug: autor.slug },
      props: {
        autor,
        documentadas: citasDocumentadasDeAutor(conjunto.citas, autor.slug),
        // Historia 17.3 — la Lista de Obras: solo la pinta la página 1.
        suObra: obrasDelAutor(conjunto.citas, autor.slug),
      },
      pageSize: CITAS_POR_PAGINA,
    }),
  );
}) satisfies GetStaticPaths;

const { autor, documentadas, suObra } = Astro.props;
const pagina = Astro.props.page as import('astro').Page<Cita>;

const ruta = rutaDeAutor(autor.slug, pagina.currentPage);

const años = añosDeAutor(autor);
const canonica = new URL(ruta, Astro.site).href;

/*
 * Historia 17.2, AD-28 — qué superficie puede reproducir la semblanza lo decide
 * `src/lib/atribucion.ts`, no esta página. Una semblanza propia sale donde siempre; una ajena
 * (el Autor declara biografía) solo en la ficha de la página 1, con su atribución debajo, y
 * donde no cabe se dicen hechos del Corpus.
 */
const semblanza = semblanzaEn(
  autor,
  pagina.currentPage === 1 ? 'ficha-de-autor' : 'paginas-siguientes',
);
// Si el índice de Pagefind puede llevarla; si no, va dentro de `data-pagefind-ignore`.
const enElIndice = semblanzaEn(autor, 'indice-de-busqueda') !== undefined;
const descripcion = descripcionDeAutor(autor, documentadas);
---

<Armazon
  titulo={tituloDeAutor(autor.nombre, pagina.currentPage)}
  descripcion={descripcion}
  tarjeta={`/tarjeta/autor/${autor.slug}.png`}
  ruta={ruta}
  tipo="autor"
  vista={pagina.currentPage === 1 ? 'superficie' : undefined}
>
  <DatosDeAutor
    slot="cabeza"
    autor={autor}
    citas={pagina.data}
    canonica={canonica}
    tramo={{ actual: pagina.currentPage, porPagina: CITAS_POR_PAGINA }}
    documentadas={documentadas}
  />
  <div class="pagina contenedor">
    <header class="ficha">
      <h1>{autor.nombre}</h1>
      <p class="años">{años}</p>
      {
        semblanza !== undefined &&
          (enElIndice ? (
            <p class="semblanza">{semblanza}</p>
          ) : (
            /*
             * Fuera del índice de Pagefind, con su atribución debajo: un resultado de búsqueda
             * la recortaría en un fragmento sin atribución.
             */
            <div data-pagefind-ignore>
              <p class="semblanza">{semblanza}</p>
              {autor.atribucion !== undefined && (
                <AtribucionDeSemblanza atribucion={autor.atribucion} />
              )}
            </div>
          ))
      }
    </header>

    {
      /*
       * Historia 17.3, UX-DR46 — la Lista de Obras, bajo la semblanza y su atribución. Ya va
       * solo en la página 1. Lo que queda para la 17.4 es la ficha entera —nombre, años,
       * semblanza—: moverla delante del catálogo y quitarla de las páginas 2+.
       */
      pagina.currentPage === 1 && <ListaDeObras obras={suObra.obras} sinObra={suObra.sinObra} />
    }

    {
      /*
       * El rótulo no lleva la cuenta. UX-DR21 pone los contadores en la misma lista que
       * el emoji y la gamificación, y aunque «6 citas documentadas» sea informativo y no
       * una medalla, el número no aporta nada que el listado de debajo no diga. Donde la
       * cuenta sí hace falta es en la paginación, y ahí la exige UX-DR18.
       */
    }
    <h2 class="rotulo">Citas documentadas</h2>

    {/* UX-DR25 — los listados son listas reales. */}
    <ul class="listado">
      {pagina.data.map((cita) => <TarjetaDeCita cita={cita} />)}
    </ul>

    <Paginacion pagina={pagina} />
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  .ficha {
    max-width: var(--medida-prosa);
  }

  h1 {
    /* La serif se aplica al nombre de Autor: es una de las tres excepciones. */
    font-family: var(--serif);
    font-size: var(--titular-md);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .años {
    margin: var(--unidad) 0 0;
    font-size: var(--pie);
    color: var(--tinta-apagada);
  }

  .semblanza {
    margin: calc(var(--unidad) * 2) 0 0;
    font-size: var(--cuerpo-lg);
    max-width: var(--medida-prosa);
  }

  .rotulo {
    margin: calc(var(--unidad) * 5) 0 0;
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .listado {
    list-style: none;
    margin: calc(var(--unidad) * 2) 0 0;
    padding: 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }
</style>
