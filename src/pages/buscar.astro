---
/**
 * Búsqueda — FR-7, FR-8.
 *
 * La página es el marco: el `h1`, la búsqueda (`src/components/Busqueda.astro`, que pinta el
 * campo, los selectores de Autor y de Tema y lleva el guion empaquetado), la región del recuento,
 * la lista de resultados y la salida sin resultados. Las reglas del guion están escritas en el
 * componente, junto a él (Historia 27.2): desde entonces `/buscar/` no lleva guion propio en línea.
 *
 * Historia 27.4 — la búsqueda vive en la dirección (`?q=&autor=&obra=&tema=`), y ninguna
 * combinación de parámetros crea ruta ni página: es siempre este único HTML, `noindex`, con
 * canónica `/buscar/` y fuera del sitemap y de Pagefind (`src/lib/superficies.ts`).
 *
 * Historia 27.5 — los resultados llegan de 30 en 30 (`TANDA_DE_RESULTADOS`): la isla pone detrás de
 * la lista, fuera de ella y de su Zona, «Mostrar 30 más» con su propia región de estado, que salen
 * de la plantilla del componente. El marcado de esta página no cambia.
 *
 * Las opciones de los selectores salen de aquí y solo de aquí: del conjunto publicable, por
 * `filtrosDeLaBusqueda` —la misma función que escribe los filtros de cada Página de Cita (27.1)—,
 * ordenadas por `ordenDeAutoresPorNombre` y `ordenDeTemasPorNombre` de `src/lib/normalizar.ts`.
 * Así no hay opción sin Citas que la filtren, ni Tema bajo su umbral.
 */
import Armazon from '../components/Armazon.astro';
import Busqueda from '../components/Busqueda.astro';
import Sostener from '../components/Sostener.astro';
import { modelosEnRuta } from '../lib/ingreso.ts';
import { tituloDe } from '../lib/marca.ts';
import { ordenDeAutoresPorNombre, ordenDeTemasPorNombre } from '../lib/normalizar.ts';
import {
  autoresPublicados,
  conjuntoPublicable,
  filtrosDeLaBusqueda,
  temasPublicados,
} from '../lib/publicado.ts';
import { rutaDeAutor, rutaDeColeccion, rutaDeTema } from '../lib/superficies.ts';

const conjunto = await conjuntoPublicable();
const temas = temasPublicados(conjunto.temas, conjunto.citas);
const autores = autoresPublicados(conjunto.autores, conjunto.citas).slice(0, 8);
/*
 * Las Colecciones publicadas también son salida — Historia 12.3.
 *
 * La salida de FR-8 ofrecía Temas y Autores, que eran las dos familias de agregación que
 * había. Dejar fuera la tercera convertiría a la Colección en la única superficie de
 * producto que la búsqueda sin resultados no sabe ofrecer, y sin ninguna razón: es
 * exactamente el mismo chip que el de Tema. Ya viene resuelto y filtrado por su umbral, y
 * la sección se omite entera cuando no hay ninguna, igual que la de Temas.
 */
const colecciones = conjunto.colecciones;

/*
 * Historia 27.2 — las opciones de los selectores: solo el valor y el nombre, en el orden que se
 * lee. El recuento de cada opción no se pinta (el rótulo es el nombre).
 */
const filtros = filtrosDeLaBusqueda(conjunto);
const opciones = ({ valor, rotulo }: { valor: string; rotulo: string }) => ({ valor, rotulo });
const autoresDelFiltro = ordenDeAutoresPorNombre(filtros.autores.map(opciones));
const temasDelFiltro = ordenDeTemasPorNombre(filtros.temas.map(opciones));
---

<Armazon
  titulo={tituloDe('Buscar')}
  descripcion="Busca una cita por un fragmento, por autor o por tema."
  ruta="/buscar/"
>
  <div class="pagina contenedor">
    <h1>Buscar</h1>

    <Busqueda autores={autoresDelFiltro} temas={temasDelFiltro} />

    {/*
      * Historia 22.10 — WCAG 4.1.3: el recuento y la búsqueda sin resultados se anuncian por
      * esta región, que está desde la carga, vacía y sin `hidden`: lo que se anuncia es un
      * cambio de contenido, no de visibilidad. Sin resultados dice la frase de la salida y se
      * aparta de la vista, para no pintarla dos veces. Historia 27.2 — la región va encima de su
      * sombra (que pone el guion, en la misma celda) y no da alto: el recuento que llega tras la
      * pausa no mueve la lista.
      */}
    <div class="recuento">
      <p class="estado" role="status" data-estado></p>
    </div>

    {/*
      * Historia 23.7 — la Zona de salida interna de los resultados va en la lista, que pinta el
      * build vacía: los `li.resultado` que mete la isla la heredan sin saber de zonas. Historia
      * 27.2 — `role="list"`: sin viñetas, algún lector deja de anunciarla como lista.
      */}
    <ul class="resultados" role="list" data-resultados data-zona="resultado"></ul>

    {/* FR-8 — la salida siempre está, en el HTML inicial. Se muestra al no haber nada. */}
    {/*
      * Historia 23.7 — exentas de zona, por escrito (UX-DR111; decisión de Héctor del 2026-10-19,
      * EXPERIENCE.md § Zonas de salida interna): las salidas de la búsqueda sin resultados no son
      * resultados, la tabla de zonas no las nombra y una zona nueva cambiaría el vocabulario —la
      * huella de AD-14 y otro despliegue del receptor—. Se revisa en la pasada de métricas.
      */}
    <div class="salida" data-salida hidden data-sin-zona="salidas-sin-resultados">
      <p class="sugerencia">
        No encontramos esa frase. Prueba con menos palabras.
      </p>

      {
        temas.length > 0 && (
          <section>
            <h2>Temas</h2>
            <ul class="chips">
              {temas.map((tema) => (
                <li>
                  <a class="chip" href={rutaDeTema(tema.slug)}>
                    {tema.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        colecciones.length > 0 && (
          <section>
            <h2>Colecciones</h2>
            <ul class="chips">
              {colecciones.map((coleccion) => (
                <li>
                  <a class="chip" href={rutaDeColeccion(coleccion.slug)}>
                    {coleccion.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2>Autores</h2>
        <ul class="chips">
          {
            autores.map((autor) => (
              <li>
                <a class="chip" href={rutaDeAutor(autor.slug)}>
                  {autor.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    {
      /*
       * La invitación a sostener el sitio — Historia 14.2, UX-DR36.
       *
       * **Fuera de `.salida`, y ahí está el detalle que importa.** Ese bloque nace con
       * `hidden` y solo se muestra cuando una búsqueda no devuelve nada: dentro, la
       * invitación existiría únicamente para quien no encontró lo que buscaba, que es el peor
       * momento posible para ofrecerla. Aquí queda al final de la columna, visible desde la
       * primera carga y sin cruzarse con ningún resultado.
       *
       * Quien decide es `modelosEnRuta` —encendido **y** admitido aquí—, no esta
       * página. Con todo apagado no se emite nada, ni contenedor ni marca (UX-DR35).
       */
      modelosEnRuta(Astro.url.pathname).map(
        (modelo) => modelo.destino !== undefined && <Sostener id={modelo.id} href={modelo.destino} />,
      )
    }
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
    max-width: var(--medida-prosa);
  }

  h1 {
    font-family: var(--sans);
    font-size: var(--titular-md);
    font-weight: 600;
    margin: 0;
  }

  /*
   * La región y la sombra del recuento comparten celda: la sombra da el alto, la región se pinta
   * encima. Sin guion solo está la región, vacía y fuera del flujo: la rejilla no mide nada.
   * La región se recorta a la fila que da la sombra: mientras corre la pausa del tecleo dice todavía
   * la frase de antes, que puede ocupar más líneas que la nueva, y sin recorte se pintaría encima
   * del primer resultado. El recorte es solo visual: los lectores leen la región entera.
   */
  .recuento {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .estado {
    position: absolute;
    inset: 0;
    overflow: hidden;
    grid-row: 1;
    grid-column: 1;
    margin: calc(var(--unidad) * 3) 0 0;
    font-family: var(--sans);
    font-size: var(--pie);
    color: var(--tinta-apagada);
    overflow-wrap: anywhere;
  }

  /* Vacía no ocupa sitio, pero sigue en el árbol de accesibilidad: no lleva `hidden`. */
  .estado:empty {
    margin: 0;
  }

  .resultados {
    list-style: none;
    margin: calc(var(--unidad) * 2) 0 0;
    padding: 0;
  }

  .resultados :global(.resultado) {
    border-bottom: var(--grosor-filete) solid var(--filete);
  }

  .resultados :global(.resultado a) {
    display: flex;
    flex-direction: column;
    gap: var(--unidad);
    min-height: var(--zona-de-toque);
    padding-block: calc(var(--unidad) * 2);
    text-decoration: none;
    color: inherit;
  }

  .resultados :global(.clase) {
    font-family: var(--sans);
    font-size: var(--pie);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .resultados :global(.titulo) {
    font-family: var(--serif);
    font-size: var(--titular-sm);
    color: var(--tinta);
  }

  /*
   * Historias 22.7 y 26.2 — el título de una Obra, de un Directorio y de la portada va en Inter:
   * mismo cuerpo y peso, solo cambia la familia.
   */
  .resultados :global(.titulo.en-sans) {
    font-family: var(--sans);
  }

  /* El Autor bajo el título de una Obra o una Cita, con el estilo `author`, como en la Tarjeta
     de Cita. */
  .resultados :global(.r-autor) {
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .salida {
    margin-top: calc(var(--unidad) * 5);
  }

  .sugerencia {
    margin: 0;
    font-size: var(--cuerpo-lg);
  }

  .salida section {
    margin-top: calc(var(--unidad) * 4);
  }

  h2 {
    margin: 0 0 calc(var(--unidad) * 2);
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--unidad);
    margin: 0;
    padding: 0;
  }

  .chip {
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    padding-inline: calc(var(--unidad) * 2);
    background: var(--contenedor);
    border-radius: var(--radio-tarjeta);
    font-family: var(--serif);
    font-size: var(--cuerpo-md);
    color: var(--tinta);
    text-decoration: none;
    /* NFR-8, Historia 26.9 — el nombre del chip es del Corpus: con el texto al 200 % una palabra
     * más ancha que la columna se parte. El chip es un elemento flexible y `break-word` no rebaja
     * su ancho mínimo; `anywhere` sí. */
    overflow-wrap: anywhere;
  }
</style>
