---
/**
 * Página de Tema — FR-6.
 *
 * Un Tema por debajo de `MIN_CITAS_POR_TEMA` no se publica. Como en la Página de Autor,
 * aquí no hay ninguna comprobación de umbral: `temasPublicados` no devuelve el Tema, la
 * ruta no se genera y su URL da 404. El umbral se aplica en un solo sitio (AD-11) y todas
 * las superficies —rutas, sitemap, chips— heredan la misma respuesta.
 *
 * A diferencia de la Página de Autor, aquí cada tarjeta lleva el nombre del Autor y el título
 * de su Obra (`atribucion="autor-y-obra"`, Historia 24.3): el Tema agrupa a varios y sin el
 * nombre el listado no dice de quién es cada frase, ni sin el título de dónde sale.
 *
 * Historia 27.8, UX-DR94 — la página 1 lleva «Buscar en este tema» bajo el `h1` y encima del
 * listado: la excepción declarada a que la Página de Tema empiece por su contenido (`DESIGN.md §
 * Do's and Don'ts`, decisión de Héctor del 18/10), y la primera Cita sigue en la primera pantalla.
 */
import Armazon from '../../../components/Armazon.astro';
import BuscarEn from '../../../components/BuscarEn.astro';
import DatosDeTema from '../../../components/DatosDeTema.astro';
import Paginacion from '../../../components/Paginacion.astro';
import TarjetaDeCita from '../../../components/TarjetaDeCita.astro';
import {
  citasDeTema,
  conjuntoPublicable,
  temasPublicados,
  type Autor,
  type Cita,
} from '../../../lib/publicado.ts';
import { ROTULO_BUSCAR_EN_ESTE_TEMA } from '../../../lib/busqueda.ts';
import { CITAS_POR_PAGINA } from '../../../lib/umbrales.ts';
import { tituloDeTema } from '../../../lib/marca.ts';
import type { GetStaticPaths } from 'astro';
import { rutaDeTema } from '../../../lib/superficies.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const conjunto = await conjuntoPublicable();
  const autores = new Map(conjunto.autores.map((a) => [a.slug, a]));

  return temasPublicados(conjunto.temas, conjunto.citas).flatMap((tema) =>
    paginate(citasDeTema(conjunto.citas, tema.slug), {
      params: { slug: tema.slug },
      props: { tema, autores },
      pageSize: CITAS_POR_PAGINA,
    }),
  );
}) satisfies GetStaticPaths;

const { tema, autores } = Astro.props as { tema: { slug: string; nombre: string }; autores: Map<string, Autor> };
const pagina = Astro.props.page as import('astro').Page<Cita>;

const ruta = rutaDeTema(tema.slug, pagina.currentPage);
const canonica = new URL(ruta, Astro.site).href;
const primera = pagina.currentPage === 1;
---

<Armazon
  titulo={tituloDeTema(tema.nombre, pagina.currentPage)}
  descripcion={`Citas sobre ${tema.nombre.toLocaleLowerCase('es')}, de varios autores, con su procedencia documentada.`}
  tarjeta={`/tarjeta/tema/${tema.slug}.png`}
  ruta={ruta}
  tipo="tema"
>
  <DatosDeTema
    slot="cabeza"
    tema={tema}
    citas={pagina.data}
    canonica={canonica}
    tramo={{ actual: pagina.currentPage, porPagina: CITAS_POR_PAGINA }}
  />
  <div class="pagina contenedor">
    <h1>{tema.nombre}</h1>

    {
      /*
       * Historia 27.8 — «Buscar en este tema», solo en la página 1: a 4 × `--unidad` del `h1`, y el
       * listado 4 × más abajo. En las 2+ el listado sigue a 4 × del `h1`.
       */
      primera && <BuscarEn id="buscar-en-este-tema" rotulo={ROTULO_BUSCAR_EN_ESTE_TEMA} filtros={{ tema: tema.slug }} />
    }

    <ul class="listado">
      {pagina.data.map((cita) => <TarjetaDeCita cita={cita} atribucion="autor-y-obra" autor={autores.get(cita.autor)} zona="listado" />)}
    </ul>

    <Paginacion pagina={pagina} zona="paginacion" />
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  h1 {
    /* La serif se aplica al nombre de Tema: es la tercera de las tres excepciones. */
    font-family: var(--serif);
    font-size: var(--titular-md);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  /* Historia 27.8 — «Buscar en este tema», a 4 × `--unidad` del `h1`. */
  .pagina > :global(.buscar-en) {
    margin-top: calc(var(--unidad) * 4);
  }

  .listado {
    list-style: none;
    margin: calc(var(--unidad) * 4) 0 0;
    padding: 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }
</style>
