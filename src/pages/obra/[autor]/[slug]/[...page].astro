---
/**
 * Página de Obra — Historia 22.4, UX-DR38 a UX-DR41, UX-DR49 y UX-DR50.
 *
 * Toda Obra con al menos una Cita publicada tiene página: es el destino del título en la
 * Atribución. Si además **se indexa** no lo decide esta página, ni ninguna ficha: lo decide
 * FR-52 (`esObraIndexable`) sobre el Corpus de cada construcción, y llega a `Armazon.astro` por
 * la declaración de `src/lib/superficies.ts`. Una Obra que no se indexa es esta misma página,
 * sin marca ni aviso, con `noindex, follow` y fuera del sitemap y de Pagefind.
 *
 * Página 1 (UX-DR124, Historia 32.4): Cabecera con la línea de Ficha técnica si la ficha está
 * atada a Wikidata (Historia 32.2); los desplegables cerrados, en un solo contenedor y antes del
 * listado —«Dónde leer esta obra» (Historias 22.6 y 32.4) y «Cómo empieza» si la ficha declara un
 * incipit que se ofrece (Historia 32.3)—; Listado, Paginación, «Buscar en esta obra» (Historia
 * 27.8; debajo del listado desde la UX v8.4, decisión de Héctor del 2026-10-30), el sitio de
 * «Compartir en» (25.6, sin hueco), Temas, «Cómo citar» plegado con su isla de copiar (Historia
 * 32.5; al pie por la decisión delegada por Héctor del 2026-11-14, para la primera pantalla) y, si
 * la ficha la trae, su nota (Historia 22.6). El salto «Dónde leer esta obra ↓» de la 24.7 se
 * retiró con la 32.4.
 * Páginas 2+: solo Cabecera y Listado, y `noindex` por forma. Nada de prosa
 * compuesta (FR-51): ni sinopsis, ni contexto, ni adjetivos; todo lo que se dice sale de hechos
 * del Corpus, salvo la nota, que escribe Héctor a mano.
 *
 * Historia 35.4 — la Obra de un Personaje es esta misma página con su dueño: la Cabecera dice «de
 * {Personaje}» enlazado a su página, el título y la meta llevan su nombre y el JSON-LD describe una
 * `CreativeWork` con su `character`. Desde la 35.5 lleva también «Buscar en esta obra», con el
 * Personaje en lugar del Autor (`?personaje=&obra=`).
 *
 * El parámetro se llama `page` porque `paginate()` lo exige por nombre, como en la Página de
 * Autor; los dos segmentos públicos salen del nombre de la ficha (`segmentosDeObra`).
 */
import Armazon from '../../../../components/Armazon.astro';
import BuscarEn from '../../../../components/BuscarEn.astro';
import Chips from '../../../../components/Chips.astro';
import ComoCitar from '../../../../components/ComoCitar.astro';
import ComoEmpieza from '../../../../components/ComoEmpieza.astro';
import Desplegable from '../../../../components/Desplegable.astro';
import DondeLeer from '../../../../components/DondeLeer.astro';
import FichaTecnica from '../../../../components/FichaTecnica.astro';
import Rotulo from '../../../../components/Rotulo.astro';
import DatosDeObra from '../../../../components/DatosDeObra.astro';
import Paginacion from '../../../../components/Paginacion.astro';
import TarjetaDeCita from '../../../../components/TarjetaDeCita.astro';
import CopiarReferencia from '../../../../islands/CopiarReferencia.astro';
import {
  autoresPublicados,
  citasDeLasObras,
  personajesPublicados,
  conjuntoPublicable,
  incipitsDeLasObras,
  obrasPublicadas,
  mensajeDeDueñoSinPagina,
  temasDeLaObra,
  temasPublicados,
} from '../../../../lib/publicado.ts';
import {
  congelacionVigente,
  dondeLeer,
  edicionQueEncabeza,
  obraTieneComoCitar,
  rutaDeLaObra,
  segmentosDeObra,
  traductorDeLaEdicionQueEncabeza,
} from '../../../../lib/obras.ts';
import { edicionesEnVenta, modelosEnRuta, TIENDAS } from '../../../../lib/ingreso.ts';
import { edicionesPorFormato } from '../../../../lib/ediciones.ts';
import { descripcionDeObra, referenciasDeObra } from '../../../../lib/atribucion.ts';
import { ROTULO_BUSCAR_EN_ESTA_OBRA } from '../../../../lib/busqueda.ts';
import { CITAS_POR_PAGINA } from '../../../../lib/umbrales.ts';
import { tituloDeObra } from '../../../../lib/marca.ts';
import { rutaDeAutor, rutaDePersonaje, rutaDeTema } from '../../../../lib/superficies.ts';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const conjunto = await conjuntoPublicable();
  // El Autor de la Cabecera es uno **publicado**: su nombre enlaza a su página.
  const autores = new Map(
    autoresPublicados(conjunto.autores, conjunto.citas).map((a) => [a.slug, a]),
  );
  // Historia 35.4 — y el Personaje dueño de una Obra, también uno publicado: enlaza a su página.
  const personajes = new Map(
    personajesPublicados(conjunto.personajes, conjunto.citas).map((p) => [p.slug, p]),
  );
  const publicados = temasPublicados(conjunto.temas, conjunto.citas);

  // Historia 24.1 — las Citas de cada Obra en el orden del libro, en todas sus páginas y en sus
  // datos estructurados. El orden lo decide `src/lib/obras.ts` y llega por el dueño del conjunto.
  const porObra = await citasDeLasObras(conjunto);
  // Historia 32.3 — el incipit de las Obras que lo declaran y lo ofrecen, por nombre de ficha.
  const incipits = await incipitsDeLasObras();

  return obrasPublicadas(conjunto).flatMap((obra) => {
    // El dueño de la Cabecera (`obra.dueño`): su Autor o su Personaje, los dos publicados.
    const autor = obra.dueño.tipo === 'autor' ? autores.get(obra.dueño.slug) : undefined;
    const personaje = obra.dueño.tipo === 'personaje' ? personajes.get(obra.dueño.slug) : undefined;
    const dueño =
      autor !== undefined
        ? ({ tipo: 'autor', autor } as const)
        : personaje !== undefined
          ? ({ tipo: 'personaje', personaje } as const)
          : undefined;
    /*
     * Un dueño sin página: la Cabecera enlazaría a un 404 sin que nada lo dijera, y el build se
     * para aquí. Un Autor siempre la tiene —las Citas que resuelven su ficha lo declaran—, pero
     * la ficha de un Personaje la resuelven también las Citas de los demás de su `personajes`,
     * y si ninguna declara al dueño, el dueño no tiene página (Historia 35.4).
     */
    if (dueño === undefined) {
      throw new Error(mensajeDeDueñoSinPagina(obra));
    }
    const { autor: segmentoDeAutor, obra: segmentoDeObra } = segmentosDeObra(obra.nombre);
    const citas = porObra.get(obra.nombre) ?? [];
    const paginas = paginate(citas, {
      params: { autor: segmentoDeAutor, slug: segmentoDeObra },
      props: { obra, dueño, temas: temasDeLaObra(citas, publicados) },
      pageSize: CITAS_POR_PAGINA,
    });
    // «Dónde leer» (22.6) y el traductor de la edición que encabeza (32.2, la línea de Ficha
    // técnica) se calculan una vez, sobre todas las Citas de la Obra, y solo los recibe la
    // página 1: las 2+ no los pintan.
    // El incipit (32.3), también solo para la página 1, y la edición que encabeza (32.5), de la
    // que la Referencia de Obra toma su rótulo y su traductor: la misma regla que el traductor.
    const resumen = dondeLeer(citas);
    const traductor = traductorDeLaEdicionQueEncabeza(citas);
    const incipit = incipits.get(obra.nombre);
    const edicion = edicionQueEncabeza(citas);
    return paginas.map((pagina, i) =>
      i === 0 ? { ...pagina, props: { ...pagina.props, dondeLeer: resumen, traductor, incipit, edicion } } : pagina,
    );
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { obra, dueño, temas, page: pagina } = Astro.props;
const nombreDelDueño = dueño.tipo === 'autor' ? dueño.autor.nombre : dueño.personaje.nombre;
const rutaDelDueño = dueño.tipo === 'autor' ? rutaDeAutor(dueño.autor.slug) : rutaDePersonaje(dueño.personaje.slug);
const resumenDondeLeer = 'dondeLeer' in Astro.props ? Astro.props.dondeLeer : undefined;
const traductor = 'traductor' in Astro.props ? Astro.props.traductor : undefined;
const incipit = 'incipit' in Astro.props ? Astro.props.incipit : undefined;
const edicion = 'edicion' in Astro.props ? Astro.props.edicion : undefined;

const ruta = rutaDeLaObra(obra, pagina.currentPage);
// Historia 22.7 — la Tarjeta Social, en todas las páginas de la Obra, se indexe o no.
const segmentos = segmentosDeObra(obra.nombre);
const tarjeta = `/tarjeta/obra/${segmentos.autor}/${segmentos.obra}.png`;
const canonica = new URL(ruta, Astro.site).href;
const primera = pagina.currentPage === 1;
/*
 * «Dónde leer esta obra» va en toda página 1, se indexe o no. La congelación de la familia Obra
 * oculta las ediciones en venta (33.2, AD-25), no el desplegable.
 */
const conDondeLeer = primera && resumenDondeLeer !== undefined;
/*
 * Historia 32.5 — «Cómo citar», solo en la página 1; si la Obra lo tiene lo dice `obraTieneComoCitar`.
 * La Referencia nombra al Autor: una Obra de Personaje (35.2) no la lleva hasta que la 35.9 decida
 * sus exclusiones.
 */
const autorDeLaReferencia = dueño.tipo === 'autor' ? dueño.autor : undefined;
const conComoCitar = primera && autorDeLaReferencia !== undefined && obraTieneComoCitar(obra);
const conIncipit = primera && incipit !== undefined;

/*
 * Historias 22.9 y 33.2 — las ediciones en venta. Se pregunta por la **ruta**: la afiliación se
 * admite en esta superficie, y `modelosEnRuta` la excluye por forma de las páginas 2+ y la deja en
 * la 1 se indexe la Obra o no. Llegan repartidas por formato y por tienda (`edicionesPorFormato`,
 * en el orden de `TIENDAS`). Con la familia Obra congelada (`congelacionVigente`, SM-11) no se
 * componen aunque el Modelo esté encendido: la ficha las conserva y ninguna página las enseña
 * (AD-25). Apagada o congelada, no hay `enVenta` y «Dónde leer» se pinta como antes.
 */
const afiliacion = modelosEnRuta(ruta).find((modelo) => modelo.id === 'afiliacion-de-libros');
const enVenta =
  afiliacion !== undefined && obra.ediciones !== undefined && congelacionVigente() === undefined
    ? {
        id: afiliacion.id,
        grupos: edicionesPorFormato(
          edicionesEnVenta(obra.ediciones, obra.nombre),
          TIENDAS.map((tienda) => tienda.clave),
        ),
      }
    : undefined;
---

<Armazon
  titulo={tituloDeObra(nombreDelDueño, obra.titulo, pagina.currentPage)}
  descripcion={descripcionDeObra({ nombre: nombreDelDueño }, obra, pagina.currentPage)}
  ruta={ruta}
  tipo="obra"
  tarjeta={tarjeta}
>
  <DatosDeObra
    slot="cabeza"
    obra={obra}
    dueño={dueño}
    citas={pagina.data}
    canonica={canonica}
    tramo={{ actual: pagina.currentPage, porPagina: CITAS_POR_PAGINA }}
  />
  <div class="pagina contenedor">
    <header class="cabecera-de-obra">
      <h1>{obra.titulo}</h1>
      {/*
        * «de {Autor} · {año}». El año es el de la Obra —omitido si sus Citas discrepan o no lo
        * dicen, y nunca el de una traducción (UX-DR51)—; el traductor no se nombra aquí. El
        * punto medio es decoración: quien usa lector de pantalla oye una coma.
        */}
      {/*
        * Historia 22.7 — `autor` es el metadato con el que `/buscar/` pinta el Autor bajo el
        * título de la Obra; Pagefind lo toma del texto del enlace. Las páginas 2+ no entran en
        * el índice, así que lo lleve o no da igual.
        */}
      {/* Historia 23.7 — el Autor de la Cabecera de Obra sale por la zona de la Atribución. */}
      <p class="de" data-zona="atribucion">
        de <a href={rutaDelDueño} class="enlace-en-tinta" data-pagefind-meta="autor">{nombreDelDueño}</a>{
          obra.año !== undefined && (
            <>
              <span aria-hidden="true"> · </span><span class="oculto">, </span>{obra.año}
            </>
          )
        }
      </p>
      {/*
        * Historia 32.2, UX-DR126 — la línea de Ficha técnica, solo en la página 1 y solo si la
        * ficha está atada a Wikidata y consta género, año o lengua; si no, no pinta nada.
        */}
      {primera && <FichaTecnica obra={obra} traductor={traductor} />}
    </header>

    {
      /*
       * Historias 32.3 y 32.4, UX-DR124, UX-DR128 — los desplegables de arriba, cerrados, entre la
       * Cabecera y el listado, solo en la página 1: «Dónde leer esta obra» (toda página 1) y «Cómo
       * empieza» si la ficha declara un incipit que se ofrece. Son **hermanos directos** dentro de
       * un solo contenedor, para que la regla `.desplegable + .desplegable` de la primitiva no doble
       * el filete entre ellos. Fuera de Pagefind y del JSON-LD: no son texto buscable de cada Obra.
       * A 2 × `--unidad` de la Cabecera (el filete del primer desplegable; decisión delegada por
       * Héctor del 2026-11-14 para la primera pantalla), con un atributo `style` para no añadir
       * reglas a la hoja de esta página. Sin `data-zona`: los enlaces de «Dónde leer» son de salida.
       * «Cómo citar» (32.5) no va aquí: va al pie (decisión 1b, delegada por Héctor el 2026-11-14).
       */
      (conDondeLeer || conIncipit) && (
        <div data-pagefind-ignore="all" style="margin-top: calc(var(--unidad) * 2)">
          {conDondeLeer && <DondeLeer resumen={resumenDondeLeer!} enVenta={enVenta} />}
          {conIncipit && <ComoEmpieza incipit={incipit!} />}
        </div>
      )
    }

    {/*
      * UX-DR40 — el listado de la Obra: las Tarjetas **sin** el Autor ni el título, que ya dice la
      * Cabecera (`atribucion="ninguna"`, FR-51, Historia 24.3).
      */}
    <ul class="listado">
      {pagina.data.map((cita) => <TarjetaDeCita cita={cita} atribucion="ninguna" zona="listado" />)}
    </ul>

    <Paginacion pagina={pagina} zona="paginacion" />

    {
      /*
       * Historia 27.8, UX-DR94, UX-DR95 — «Buscar en esta obra», solo en la página 1 —se indexe la
       * Obra o no, y con la familia congelada o sin congelar—, **debajo** del listado que filtra y
       * de su paginación (UX v8.4, decisión de Héctor del 2026-10-30): encima echaba de la primera
       * pantalla de 360 × 640 la primera Cita de las Obras de título largo. Va a 5 × `--unidad` de
       * la paginación —o de la última tarjeta, sin ella— y Temas conserva su 5 ×, ahora medido
       * desde el formulario. Lleva los dos filtros, el Autor y la Obra por el nombre de su ficha,
       * que es su interfaz pública (nunca el título). Las 2+ no lo llevan.
       */
      primera && (
        <BuscarEn
          id="buscar-en-esta-obra"
          rotulo={ROTULO_BUSCAR_EN_ESTA_OBRA}
          filtros={
            dueño.tipo === 'autor'
              ? { autor: dueño.autor.slug, obra: obra.nombre }
              : { personaje: dueño.personaje.slug, obra: obra.nombre }
          }
        />
      )
    }

    {
      primera && temas.length > 0 && (
        <section class="temas" aria-labelledby="temas-de-la-obra">
          <Rotulo id="temas-de-la-obra">Temas</Rotulo>
          <Chips enlaces={temas.map((tema) => ({ href: rutaDeTema(tema.slug), nombre: tema.nombre }))} zona="chip-de-tema" />
        </section>
      )
    }

    {
      /*
       * Historia 32.5, UX-DR129 — «Cómo citar», plegado, solo en la página 1 y si la Obra lo tiene:
       * al pie, tras los Temas (o «Buscar en esta obra», sin Temas) y antes de la nota. Lo bajó del
       * contenedor de arriba la decisión 1b, delegada por Héctor el 2026-11-14: con él como tercer
       * desplegable la primera Tarjeta del listado salía de la primera pantalla de 360 × 640. A
       * 5 × `--unidad` de lo que lo precede, el ritmo de los bloques del pie, en un atributo
       * `style`. Fuera de Pagefind y del JSON-LD; sin enlaces ni `data-zona`: la canónica es texto
       * de las Referencias. La isla de copiar (`CopiarReferencia`, empaquetada) pone la fecha del
       * visitante y copia, y su guion va fuera del contenedor.
       */
      conComoCitar && autorDeLaReferencia !== undefined && (
        <div data-pagefind-ignore="all" style="margin-top: calc(var(--unidad) * 5)">
          <Desplegable rotulo="Cómo citar"><ComoCitar referencias={referenciasDeObra(obra, autorDeLaReferencia, edicion, canonica)} /></Desplegable>
        </div>
      )
    }
    {conComoCitar && <CopiarReferencia />}

    {
      /*
       * UX-DR44 — la nota de la ficha, fuera de la sección y sin encabezado, tras un filete. La
       * escribe Héctor; nunca va en la meta ni en la Tarjeta.
       */
      primera && obra.nota !== undefined && (
        <p class="nota-de-la-ficha" data-pagefind-ignore>{obra.nota}</p>
      )
    }
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  /*
   * UX-DR38, UX-DR39 — el título de una Obra va en Inter, nunca en la serif, con su propio
   * token. Sin máximo de líneas ni segundo tamaño: un título largo parte palabras antes que
   * desbordar los 360 px.
   */
  h1 {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--titular-obra);
    font-weight: var(--peso-fuerte);
    line-height: var(--interlineado-titular-obra);
    color: var(--tinta);
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .de {
    margin: var(--unidad) 0 0;
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    line-height: var(--interlineado-cuerpo-md);
    color: var(--tinta-apagada);
  }

  /*
   * El nombre es información y no una acción: en tinta, subrayado siempre. Color y subrayado
   * son `.enlace-en-tinta` (src/styles/tokens.css), la misma regla que la Atribución
   * (Historia 22.5). La zona de toque llega a `--zona-de-toque` (44 px) con relleno y se devuelve
   * con margen negativo, para que el ritmo vertical no se mueva. El relleno es lo que le falta a
   * la línea (`--cuerpo-md` × 1,6 = 24 px, el interlineado de `.de`) para llegar a 44, repartido
   * por igual: 10 + 10. Si cambia el interlineado de `.de`, hay que cambiar aquí el 1,6.
   */
  .de a {
    display: inline-block;
    /* NFR-8, Historia 26.9 — el nombre del Autor es del Corpus: con el texto al 200 % una palabra
     * más ancha que la columna se parte. En un `inline-block`, `break-word` no basta: no rebaja
     * el ancho mínimo de la caja. */
    overflow-wrap: anywhere;
    padding-block: calc((var(--zona-de-toque) - var(--cuerpo-md) * 1.6) / 2);
    margin-block: calc((var(--cuerpo-md) * 1.6 - var(--zona-de-toque)) / 2);
  }

  /* Sin clase global para esto: es la misma regla que `Paginacion.astro` declara para sí. */
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * Historia 27.8, UX-DR95 — «Buscar en esta obra», a 5 × `--unidad` de la paginación o, sin ella,
   * de la última tarjeta: el margen es del formulario, así vale en los dos casos sin tocar
   * `Paginacion.astro`, que comparten Autor, Tema y Colección. Va aquí, y no junto a `.temas`, que
   * declara lo mismo: dos reglas iguales seguidas las funde el minificador en una sola lista de
   * selectores, y la regla de `.temas` dejaría de existir por sí sola en la hoja emitida.
   */
  .pagina > :global(.buscar-en) {
    margin-top: calc(var(--unidad) * 5);
  }

  .listado {
    list-style: none;
    margin: calc(var(--unidad) * 4) 0 0;
    padding: 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }

  /* UX-DR42, UX-DR95 — 5 × `--unidad` a «Temas» desde lo que lo preceda: «Buscar en esta obra». */
  .temas {
    margin-top: calc(var(--unidad) * 5);
  }

  /*
   * UX-DR44 — la nota: `caption` en tinta apagada, dentro de la medida de prosa, con 4 ×
   * `--unidad` por encima del filete y 3 × por debajo.
   */
  .nota-de-la-ficha {
    max-width: var(--medida-prosa);
    margin: calc(var(--unidad) * 4) 0 0;
    padding-top: calc(var(--unidad) * 3);
    border-top: var(--grosor-filete) solid var(--filete);
    font-family: var(--sans);
    font-size: var(--pie);
    line-height: var(--interlineado-pie);
    color: var(--tinta-apagada);
  }
</style>
