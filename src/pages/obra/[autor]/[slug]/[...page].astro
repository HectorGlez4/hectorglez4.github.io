---
/**
 * Página de Obra — Historia 22.4, UX-DR38 a UX-DR41, UX-DR49 y UX-DR50.
 *
 * Toda Obra con al menos una Cita publicada tiene página: es el destino del título en la
 * Atribución. Si además **se indexa** no lo decide esta página, ni ninguna ficha: lo decide
 * FR-52 (`esObraIndexable`) sobre el Corpus de cada construcción, y llega a `Armazon.astro` por
 * la declaración de `src/lib/superficies.ts`. Una Obra que no se indexa es esta misma página,
 * sin marca ni aviso, con `noindex, follow` y fuera del sitemap y de Pagefind.
 *
 * Página 1: Cabecera con el salto «Dónde leer esta obra ↓» (Historia 24.7), Listado, Paginación,
 * «Buscar en esta obra» (Historia 27.8; debajo del listado desde la UX v8.4, decisión de Héctor del
 * 2026-10-30), Temas, «Dónde leer esta obra» y, si la ficha la trae, su nota (Historia 22.6).
 * Páginas 2+: solo Cabecera, sin salto, y Listado, y `noindex` por forma. Nada de prosa
 * compuesta (FR-51): ni sinopsis, ni contexto, ni adjetivos; todo lo que se dice sale de hechos
 * del Corpus, salvo la nota, que escribe Héctor a mano.
 *
 * El parámetro se llama `page` porque `paginate()` lo exige por nombre, como en la Página de
 * Autor; los dos segmentos públicos salen del nombre de la ficha (`segmentosDeObra`).
 */
import Armazon from '../../../../components/Armazon.astro';
import BuscarEn from '../../../../components/BuscarEn.astro';
import Chips from '../../../../components/Chips.astro';
import DondeLeer from '../../../../components/DondeLeer.astro';
import Rotulo from '../../../../components/Rotulo.astro';
import DatosDeObra from '../../../../components/DatosDeObra.astro';
import Paginacion from '../../../../components/Paginacion.astro';
import TarjetaDeCita from '../../../../components/TarjetaDeCita.astro';
import {
  autoresPublicados,
  citasDeLasObras,
  conjuntoPublicable,
  obrasPublicadas,
  temasDeLaObra,
  temasPublicados,
} from '../../../../lib/publicado.ts';
import {
  ANCLA_DE_DONDE_LEER,
  ROTULO_DE_DONDE_LEER,
  dondeLeer,
  rutaDeLaObra,
  segmentosDeObra,
} from '../../../../lib/obras.ts';
import { edicionesEnVenta, modelosEnRuta } from '../../../../lib/ingreso.ts';
import { descripcionDeObra } from '../../../../lib/atribucion.ts';
import { ROTULO_BUSCAR_EN_ESTA_OBRA } from '../../../../lib/busqueda.ts';
import { CITAS_POR_PAGINA } from '../../../../lib/umbrales.ts';
import { tituloDeObra } from '../../../../lib/marca.ts';
import { rutaDeAutor, rutaDeTema } from '../../../../lib/superficies.ts';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const conjunto = await conjuntoPublicable();
  // El Autor de la Cabecera es uno **publicado**: su nombre enlaza a su página.
  const autores = new Map(
    autoresPublicados(conjunto.autores, conjunto.citas).map((a) => [a.slug, a]),
  );
  const publicados = temasPublicados(conjunto.temas, conjunto.citas);

  // Historia 24.1 — las Citas de cada Obra en el orden del libro, en todas sus páginas y en sus
  // datos estructurados. El orden lo decide `src/lib/obras.ts` y llega por el dueño del conjunto.
  const porObra = await citasDeLasObras(conjunto);

  return obrasPublicadas(conjunto).flatMap((obra) => {
    const autor = autores.get(obra.autor);
    // No debería pasar —la integridad del conjunto y la puerta de las fichas lo impiden—, pero
    // si pasara, la Cabecera enlazaría a un 404 sin que nada lo dijera: el build se para aquí.
    if (autor === undefined) {
      throw new Error(
        `La Obra «${obra.nombre}» es de «${obra.autor}», que no tiene Página de Autor publicada: ` +
          'su Cabecera enlazaría a un 404.',
      );
    }
    const { autor: segmentoDeAutor, obra: segmentoDeObra } = segmentosDeObra(obra.nombre);
    const citas = porObra.get(obra.nombre) ?? [];
    const paginas = paginate(citas, {
      params: { autor: segmentoDeAutor, slug: segmentoDeObra },
      props: { obra, autor, temas: temasDeLaObra(citas, publicados) },
      pageSize: CITAS_POR_PAGINA,
    });
    // «Dónde leer» (22.6) se calcula una vez, sobre todas las Citas de la Obra, y solo lo
    // recibe la página 1: las 2+ no lo pintan.
    const resumen = dondeLeer(citas);
    return paginas.map((pagina, i) =>
      i === 0 ? { ...pagina, props: { ...pagina.props, dondeLeer: resumen } } : pagina,
    );
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { obra, autor, temas, page: pagina } = Astro.props;
const resumenDondeLeer = 'dondeLeer' in Astro.props ? Astro.props.dondeLeer : undefined;

const ruta = rutaDeLaObra(obra, pagina.currentPage);
// Historia 22.7 — la Tarjeta Social, en todas las páginas de la Obra, se indexe o no.
const segmentos = segmentosDeObra(obra.nombre);
const tarjeta = `/tarjeta/obra/${segmentos.autor}/${segmentos.obra}.png`;
const canonica = new URL(ruta, Astro.site).href;
const primera = pagina.currentPage === 1;
/*
 * Historia 24.7 — un solo booleano decide si la página pinta «Dónde leer esta obra» y si lleva el
 * salto que va a ella: un salto sin destino sería un enlace muerto, y un destino sin salto, el
 * bloque al pie detrás de una página entera de Tarjetas (`CITAS_POR_PAGINA`). Hoy es toda página
 * 1, se indexe o no, congelada o no.
 */
const conDondeLeer = primera && resumenDondeLeer !== undefined;

/*
 * Historia 22.9 — las ediciones en venta. Se pregunta por la **ruta**: la afiliación se admite
 * en esta superficie, y `modelosEnRuta` la excluye por forma de las páginas 2+ y la deja en la 1
 * se indexe la Obra o no. Apagada, no hay `enVenta` y «Dónde leer» se pinta como antes.
 */
const afiliacion = modelosEnRuta(ruta).find((modelo) => modelo.id === 'afiliacion-de-libros');
const enVenta =
  afiliacion !== undefined && obra.ediciones !== undefined
    ? { id: afiliacion.id, ediciones: edicionesEnVenta(obra.ediciones) }
    : undefined;
---

<Armazon
  titulo={tituloDeObra(autor.nombre, obra.titulo, pagina.currentPage)}
  descripcion={descripcionDeObra(autor, obra, pagina.currentPage)}
  ruta={ruta}
  tipo="obra"
  tarjeta={tarjeta}
>
  <DatosDeObra
    slot="cabeza"
    obra={obra}
    autor={autor}
    citas={pagina.data}
    canonica={canonica}
    tramo={{ actual: pagina.currentPage, porPagina: CITAS_POR_PAGINA }}
  />
  <div class="pagina contenedor">
    <header class="cabecera-de-obra">
      <h1>{obra.titulo}</h1>
      {/*
        * «de {Autor} · {año}». El año es el de la Obra —omitido si sus Citas discrepan o no lo
        * dicen, y nunca el de una traducción (UX-DR51)—; el traductor no se nombra aquí. El
        * punto medio es decoración: quien usa lector de pantalla oye una coma.
        */}
      {/*
        * Historia 22.7 — `autor` es el metadato con el que `/buscar/` pinta el Autor bajo el
        * título de la Obra; Pagefind lo toma del texto del enlace. Las páginas 2+ no entran en
        * el índice, así que lo lleve o no da igual.
        */}
      {/* Historia 23.7 — el Autor de la Cabecera de Obra sale por la zona de la Atribución. */}
      <p class="de" data-zona="atribucion">
        de <a href={rutaDeAutor(autor.slug)} class="enlace-en-tinta" data-pagefind-meta="autor">{autor.nombre}</a>{
          obra.año !== undefined && (
            <>
              <span aria-hidden="true"> · </span><span class="oculto">, </span>{obra.año}
            </>
          )
        }
      </p>
      {
        /*
         * Historia 24.7, UX-DR96 — el salto a «Dónde leer esta obra», en su propia línea y fuera de
         * `p.de`, que declara la zona de la Atribución: es un ancla de la propia página, ya exenta
         * de zona (AD-13), y va en la misma pestaña. La flecha es decoración. Fuera de Pagefind por
         * lo mismo que la sección: no es texto buscable de cada Obra. Su texto es el del rótulo de
         * destino, `ROTULO_DE_DONDE_LEER`: el salto se llama como el encabezado al que lleva.
         */
        conDondeLeer && (
          <p class="salto" data-pagefind-ignore><a href={`#${ANCLA_DE_DONDE_LEER}`}>{ROTULO_DE_DONDE_LEER}<span aria-hidden="true">&nbsp;↓</span></a></p>
        )
      }
    </header>

    {/*
      * UX-DR40 — el listado de la Obra: las Tarjetas **sin** el Autor ni el título, que ya dice la
      * Cabecera (`atribucion="ninguna"`, FR-51, Historia 24.3).
      */}
    <ul class="listado">
      {pagina.data.map((cita) => <TarjetaDeCita cita={cita} atribucion="ninguna" zona="listado" />)}
    </ul>

    <Paginacion pagina={pagina} zona="paginacion" />

    {
      /*
       * Historia 27.8, UX-DR94, UX-DR95 — «Buscar en esta obra», solo en la página 1 —se indexe la
       * Obra o no, y con la familia congelada o sin congelar—, **debajo** del listado que filtra y
       * de su paginación (UX v8.4, decisión de Héctor del 2026-10-30): encima echaba de la primera
       * pantalla de 360 × 640 la primera Cita de las Obras de título largo. Va a 5 × `--unidad` de
       * la paginación —o de la última tarjeta, sin ella— y Temas conserva su 5 ×, ahora medido
       * desde el formulario. Lleva los dos filtros, el Autor y la Obra por el nombre de su ficha,
       * que es su interfaz pública (nunca el título). Las 2+ no lo llevan.
       */
      primera && (
        <BuscarEn id="buscar-en-esta-obra" rotulo={ROTULO_BUSCAR_EN_ESTA_OBRA} filtros={{ autor: autor.slug, obra: obra.nombre }} />
      )
    }

    {
      primera && temas.length > 0 && (
        <section class="temas" aria-labelledby="temas-de-la-obra">
          <Rotulo id="temas-de-la-obra">Temas</Rotulo>
          <Chips enlaces={temas.map((tema) => ({ href: rutaDeTema(tema.slug), nombre: tema.nombre }))} zona="chip-de-tema" />
        </section>
      )
    }

    {/* UX-DR42 — al pie de la página 1, después del Listado, la Paginación y los Temas. */}
    {conDondeLeer && <DondeLeer resumen={resumenDondeLeer} enVenta={enVenta} />}

    {
      /*
       * UX-DR44 — la nota de la ficha, fuera de la sección y sin encabezado, tras un filete. La
       * escribe Héctor; nunca va en la meta ni en la Tarjeta.
       */
      primera && obra.nota !== undefined && (
        <p class="nota-de-la-ficha" data-pagefind-ignore>{obra.nota}</p>
      )
    }
  </div>
</Armazon>

<style>
  .pagina {
    padding-block: var(--respiracion);
  }

  /*
   * UX-DR38, UX-DR39 — el título de una Obra va en Inter, nunca en la serif, con su propio
   * token. Sin máximo de líneas ni segundo tamaño: un título largo parte palabras antes que
   * desbordar los 360 px.
   */
  h1 {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--titular-obra);
    font-weight: 600;
    line-height: 1.25;
    color: var(--tinta);
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .de {
    margin: var(--unidad) 0 0;
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    line-height: 1.6;
    color: var(--tinta-apagada);
  }

  /*
   * El nombre es información y no una acción: en tinta, subrayado siempre. Color y subrayado
   * son `.enlace-en-tinta` (src/styles/tokens.css), la misma regla que la Atribución
   * (Historia 22.5). La zona de toque llega a `--zona-de-toque` (44 px) con relleno y se devuelve
   * con margen negativo, para que el ritmo vertical no se mueva. El relleno es lo que le falta a
   * la línea (`--cuerpo-md` × 1,6 = 24 px, el interlineado de `.de`) para llegar a 44, repartido
   * por igual: 10 + 10. Si cambia el interlineado de `.de`, hay que cambiar aquí el 1,6.
   */
  .de a {
    display: inline-block;
    /* NFR-8, Historia 26.9 — el nombre del Autor es del Corpus: con el texto al 200 % una palabra
     * más ancha que la columna se parte. En un `inline-block`, `break-word` no basta: no rebaja
     * el ancho mínimo de la caja. */
    overflow-wrap: anywhere;
    padding-block: calc((var(--zona-de-toque) - var(--cuerpo-md) * 1.6) / 2);
    margin-block: calc((var(--cuerpo-md) * 1.6 - var(--zona-de-toque)) / 2);
  }

  /*
   * Historia 24.7, UX-DR96 — el salto. 3 × `--unidad` de aire sobre su línea es lo mínimo: la zona
   * de «de {Autor}» asoma 10 px bajo `p.de`, y la de este enlace (`inline-flex` de 44 px, que llena
   * la línea de su párrafo) empieza en el borde de `p.salto`; 24 − 10 deja 14 px entre las dos, por
   * encima de los 8 que pide UX-DR96 (con 2 × serían 6). Siena, porque es una acción, y subrayado
   * siempre: no hay regla de `:hover` que lo quite. El foco es el anillo global de `tokens.css`.
   */
  .salto {
    margin: calc(var(--unidad) * 3) 0 0;
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    line-height: 1.6;
  }

  .salto a {
    display: inline-flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    color: var(--siena);
    text-decoration-line: underline;
    text-decoration-thickness: var(--grosor-filete);
  }

  /* Sin clase global para esto: es la misma regla que `Paginacion.astro` declara para sí. */
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * Historia 27.8, UX-DR95 — «Buscar en esta obra», a 5 × `--unidad` de la paginación o, sin ella,
   * de la última tarjeta: el margen es del formulario, así vale en los dos casos sin tocar
   * `Paginacion.astro`, que comparten Autor, Tema y Colección. Va aquí, y no junto a `.temas`, que
   * declara lo mismo: dos reglas iguales seguidas las funde el minificador en una sola lista de
   * selectores, y la regla de `.temas` dejaría de existir por sí sola en la hoja emitida.
   */
  .pagina > :global(.buscar-en) {
    margin-top: calc(var(--unidad) * 5);
  }

  .listado {
    list-style: none;
    margin: calc(var(--unidad) * 4) 0 0;
    padding: 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }

  /* UX-DR42, UX-DR95 — 5 × `--unidad` a «Temas» desde lo que lo preceda: «Buscar en esta obra». */
  .temas {
    margin-top: calc(var(--unidad) * 5);
  }

  /*
   * UX-DR44 — la nota: `caption` en tinta apagada, dentro de la medida de prosa, con 4 ×
   * `--unidad` por encima del filete y 3 × por debajo.
   */
  .nota-de-la-ficha {
    max-width: var(--medida-prosa);
    margin: calc(var(--unidad) * 4) 0 0;
    padding-top: calc(var(--unidad) * 3);
    border-top: var(--grosor-filete) solid var(--filete);
    font-family: var(--sans);
    font-size: var(--pie);
    line-height: 1.5;
    color: var(--tinta-apagada);
  }
</style>
