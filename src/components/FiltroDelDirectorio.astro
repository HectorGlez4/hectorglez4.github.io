---
/**
 * El Campo de filtro del Directorio — Historia 26.6, FR-55, UX-DR58, UX-DR81, UX-DR85, UX-DR86;
 * `DESIGN.md § Directorios → Campo de filtro` y `EXPERIENCE.md § Campo de filtro del Directorio`.
 *
 * Lo usan `/autores/` y `/obras/`, entre el `h1` y las letras, y nadie más. Pinta tres cosas:
 *
 *   · un `<template>` con el Campo de búsqueda, la sombra del recuento y el párrafo del enlace a
 *     cero, inertes: el guion
 *     los inserta al cargar, sin hueco reservado (UX-DR35). Sin guion —o si el fichero no llega—
 *     no hay campo, la lista está entera y las letras saltan, porque son anclas. Ir en plantilla y
 *     no en `createElement` deja la etiqueta, el enlace y sus estilos de ámbito en el build, y el
 *     guion sin una palabra de contenido. El `<a>` de la plantilla no lleva `href` hasta que hay
 *     algo que buscar, así que no es un enlace interno;
 *   · la región `role="status"` del recuento, **en el HTML inicial**, vacía y sin `hidden`
 *     (`.recuento:empty` no ocupa alto): existe antes del primer mensaje, como pide la Accessibility
 *     Floor, y vacía deja las letras a 3 × `--unidad` del `h1`;
 *   · el `<script>`, que Astro empaqueta en un fichero de `/_astro/` (AD-6) y que nunca va en línea
 *     (`assetsInlineLimit` en `astro.config.mjs`). Está en la lista cerrada de
 *     `src/lib/guiones.ts` con su tope, `MAX_BYTES_GUION_DEL_FILTRO`.
 *
 * El guion lee una sola vez el modelo de la página —los nombres de `/autores/`, los Autores y los
 * títulos de `/obras/`—, y no lo lleva dentro: así el fichero es el mismo para los dos Directorios
 * y no engorda `/obras/` con un atributo por fila (`MAX_BYTES_DEL_DIRECTORIO_DE_OBRAS`). Qué queda
 * con lo tecleado lo decide `src/lib/filtroDelDirectorio.ts`; aquí solo se pinta, con `hidden`.
 * La lista se repinta al teclear y el enlace a cero aparece al momento; la frase llega por el
 * segundo ritmo (`ritmoDeTecleo`, tras `PAUSA_DE_TECLEO_MS` y solo si cambió). Lo tecleado entra
 * en la región y en el enlace solo por `textContent` y por un `href` codificado.
 *
 * El guion no lee ni escribe la dirección ni el historial, no escucha `click` en la ventana y no
 * lleva contenido del Corpus. El contenedor va fuera de Pagefind (`data-pagefind-ignore="all"`).
 */
import CampoDeBusqueda from './CampoDeBusqueda.astro';
import { ETIQUETA_DEL_FILTRO, type DirectorioFiltrable } from '../lib/filtroDelDirectorio.ts';
import { rutaDeLaBusqueda } from '../lib/superficies.ts';

interface Props {
  directorio: DirectorioFiltrable;
}

const { directorio } = Astro.props;
---

<div class="filtro" data-filtro={directorio} data-buscar={rutaDeLaBusqueda()} data-pagefind-ignore="all">
  <template>
    <div class="campo"><CampoDeBusqueda id={`filtro-de-${directorio}`} etiqueta={ETIQUETA_DEL_FILTRO[directorio]} /></div>
    <p class="sombra" aria-hidden="true"></p>
    <p class="a-cero" data-zona="directorio" hidden><a></a></p>
  </template>
  <p class="recuento" role="status"></p>
</div>

<style>
  /*
   * Tres filas: el campo, el recuento y el enlace a cero. La región y su sombra comparten la del
   * recuento, y la fila mide lo que la sombra (ver `.recuento` y `.sombra`). Sin guion solo está
   * la región, vacía y fuera del flujo: la rejilla no mide nada.
   */
  .filtro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* El campo, a 3 × `--unidad` del `h1`. */
  .campo {
    grid-row: 1;
    margin-top: calc(var(--unidad) * 3);
  }

  /* El recuento, a 2 × bajo el campo, en el pie y la tinta apagada, a la vista. */
  .recuento,
  .sombra {
    grid-row: 2;
    grid-column: 1;
    margin: calc(var(--unidad) * 2) 0 0;
    font-family: var(--sans);
    font-size: var(--pie);
    color: var(--tinta-apagada);
    /* Lo tecleado va entre comillas en la frase a cero: una palabra larga no ensancha la página. */
    overflow-wrap: anywhere;
  }

  /*
   * La región no da alto a la fila: se pinta encima de la sombra, en su sitio, y el alto lo da
   * solo la sombra, que cambia al teclear. Si la región lo diera, una frase más corta que la que
   * había —la frase a cero de dos líneas que pasa a «14 autores.»— dejaría la fila alta durante la
   * pausa y la lista subiría 700 ms después, bajo el dedo.
   */
  .recuento {
    position: absolute;
    inset-inline: 0;
    top: 0;
  }

  /* Vacía no ocupa sitio, pero sigue en el árbol de accesibilidad: no lleva `hidden`. */
  .recuento:empty,
  .sombra:empty {
    margin: 0;
  }

  /*
   * La sombra lleva, al teclear, la frase que la región escribirá tras la pausa, invisible y
   * fuera del árbol de accesibilidad: la fila del recuento toma su alto al momento, con la lista
   * y el enlace a cero, y cuando la frase llega a la región no se mueve nada, ni al crecer ni al
   * menguar. Sin ella la frase movería, 700 ms después, la lista y el enlace que el visitante ya
   * iba a tocar.
   */
  .sombra {
    visibility: hidden;
  }

  .a-cero {
    grid-row: 3;
    margin: var(--unidad) 0 0;
  }

  /* Lleva a otra página: siena y subrayado, con su zona de toque entera. */
  .a-cero a {
    display: inline-flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    color: var(--siena);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }

  /*
   * Lo que el filtro aparta lleva `hidden`, y `hidden` gana siempre: ningún `display` de un
   * componente del listado —ni el de esta plantilla— puede volver a mostrarlo.
   */
  .a-cero[hidden],
  :global(.listado [hidden]) {
    display: none !important;
  }
</style>

<script>
  import {
    filtroDe,
    fraseDelFiltro,
    rutaDeBuscarEnLasCitas,
    textoDeBuscarEnLasCitas,
    type DirectorioFiltrable,
    type GrupoFiltrable,
  } from '../lib/filtroDelDirectorio.ts';
  import { ritmoDeTecleo } from '../lib/anuncio.ts';
  import { PAUSA_DE_TECLEO_MS } from '../lib/umbrales.ts';

  /** Lo que se oculta o se muestra con cada fila, bloque y grupo del modelo, en su orden. */
  interface Pintable {
    grupo: HTMLElement;
    bloques: { bloque?: HTMLElement; filas: HTMLElement[] }[];
  }

  /**
   * El texto de una fila: el nombre en `/autores/`; en `/obras/`, el título sin año ni recuento.
   * Lo que se lee aquí —`li.fila-de-bloque` con su `.nombre`; `section.autor` con `h3 a` y
   * `.lista-de-obras > li` con el título como primer nodo de texto de `.titulo`— lo fija sobre el
   * `dist/` `tests/unit/ayuda/filtro.ts`, y el guion construido lo ejecuta
   * `tests/unit/ayuda/filtroEjecutado.ts`: un cambio de marcado no deja el filtro mudo en verde.
   */
  function textoDeFila(directorio: DirectorioFiltrable, fila: HTMLElement): string {
    if (directorio === 'autores') return fila.querySelector('.nombre')?.textContent ?? '';
    // El título es el primer nodo de texto de `.titulo`: detrás van el año y el recuento ocultos.
    return fila.querySelector('.titulo')?.firstChild?.nodeValue ?? '';
  }

  /** Lee una vez, de la página, qué se pinta y con qué texto casa. */
  function leer(directorio: DirectorioFiltrable, listado: HTMLElement) {
    const modelo: GrupoFiltrable[] = [];
    const pintables: Pintable[] = [];
    for (const grupo of listado.querySelectorAll<HTMLElement>('section.grupo')) {
      const bloques =
        directorio === 'autores'
          ? [{ bloque: undefined, cabecera: undefined, filas: [...grupo.querySelectorAll<HTMLElement>('li.fila-de-bloque')] }]
          : [...grupo.querySelectorAll<HTMLElement>('section.autor')].map((bloque) => ({
              bloque,
              // El nombre del Autor es el texto de su enlace, no el del `h3` entero.
              cabecera: bloque.querySelector('h3 a')?.textContent ?? '',
              filas: [...bloque.querySelectorAll<HTMLElement>('.lista-de-obras > li')],
            }));
      modelo.push({
        bloques: bloques.map(({ cabecera, filas }) => ({
          ...(cabecera === undefined ? {} : { cabecera }),
          filas: filas.map((fila) => textoDeFila(directorio, fila)),
        })),
      });
      pintables.push({ grupo, bloques: bloques.map(({ bloque, filas }) => ({ bloque, filas })) });
    }
    return { modelo, pintables };
  }

  function iniciar(raiz: HTMLElement) {
    const directorio = raiz.dataset.filtro as DirectorioFiltrable;
    const busqueda = raiz.dataset.buscar ?? '';
    const plantilla = raiz.querySelector('template');
    const region = raiz.querySelector<HTMLElement>('[role="status"]');
    const listado = raiz.parentElement?.querySelector<HTMLElement>('.listado');
    if (plantilla === null || region === null || listado == null) return;

    const contenido = plantilla.content.cloneNode(true) as DocumentFragment;
    const campo = contenido.querySelector<HTMLElement>('.campo');
    const entrada = contenido.querySelector<HTMLInputElement>('input');
    const sombra = contenido.querySelector<HTMLElement>('.sombra');
    const aCero = contenido.querySelector<HTMLElement>('.a-cero');
    const enlace = aCero?.querySelector('a');
    if (campo === null || entrada === null || sombra === null || aCero === null || enlace == null) return;

    const { modelo, pintables } = leer(directorio, listado);
    const filtrar = filtroDe(modelo);
    const ritmo = ritmoDeTecleo(region, PAUSA_DE_TECLEO_MS);
    const letras = listado.querySelector<HTMLElement>('#letras');
    const volveres = [...listado.querySelectorAll<HTMLElement>('p.volver')];

    raiz.insertBefore(campo, region);
    raiz.insertBefore(sombra, region);
    region.after(aCero);

    const alTeclear = () => {
      const tecleado = entrada.value;
      const resultado = filtrar(tecleado);
      pintables.forEach((pintable, g) => {
        const grupo = resultado.grupos[g];
        pintable.grupo.hidden = !grupo.visible;
        pintable.bloques.forEach((deBloque, b) => {
          const bloque = grupo.bloques[b];
          if (deBloque.bloque !== undefined) deBloque.bloque.hidden = !bloque.visible;
          deBloque.filas.forEach((fila, f) => (fila.hidden = !bloque.filas[f]));
        });
      });
      if (letras !== null) letras.hidden = !resultado.vacia;
      for (const volver of volveres) volver.hidden = !resultado.vacia;

      const aCeroVisible = !resultado.vacia && resultado.filas === 0;
      aCero.hidden = !aCeroVisible;
      if (aCeroVisible) {
        enlace.textContent = textoDeBuscarEnLasCitas(tecleado);
        enlace.href = rutaDeBuscarEnLasCitas(busqueda, tecleado);
      } else {
        enlace.textContent = '';
        enlace.removeAttribute('href');
      }

      const frase = resultado.vacia ? '' : fraseDelFiltro(directorio, resultado.filas, tecleado);
      sombra.textContent = frase;
      if (resultado.vacia) ritmo.vaciar();
      else ritmo.anunciar(frase);
    };

    // Mientras se compone una letra —la tecla muerta de la tilde, un IME—, el valor lleva el signo
    // suelto («gonz´»), que no casa con nada: se espera a la letra compuesta, que llega con
    // `compositionend` (o con el `input` que lo sigue, según el navegador; repetirla no cambia nada).
    entrada.addEventListener('input', (e) => {
      if (!(e as InputEvent).isComposing) alTeclear();
    });
    entrada.addEventListener('compositionend', alTeclear);
  }

  const raiz = document.querySelector<HTMLElement>('[data-filtro]');
  if (raiz !== null) iniciar(raiz);
</script>
