---
/**
 * El Campo de búsqueda de la v8 — Historia 26.6, UX-DR58, UX-DR81, `DESIGN.md § Búsqueda → Campo
 * de búsqueda`.
 *
 * Nace aquí, con su primer uso: el filtro de los Directorios (`FiltroDelDirectorio.astro`), que lo
 * inserta desde un `<template>` al cargar. La Épica 27 lo lleva a `/buscar/`, la portada, el 404 y
 * «Buscar en…», y la 27 y la 28 le añaden lo que esos usos piden —el botón «Buscar» y el `name`
 * que envía—; el filtro, que responde al teclear, no lleva ni botón ni formulario.
 *
 * La etiqueta, visible y encima, en el pie y la tinta apagada, a `--unidad` del campo. Lo tecleado
 * va en Inter, al cuerpo grande y en tinta —nunca la serif, que es solo para texto de Cita y
 * nombres—, sin caja, sin sombra, sin radio y sin icono (sin `placeholder`, salvo el ejemplo de
 * `/buscar/`, más abajo): un filete inferior en
 * el contorno, que al recibir el foco pasa a siena y al doble de grueso **además** del anillo
 * global de `tokens.css`, nunca en su lugar. Sin la cruz nativa de `type="search"`, que sería un
 * botón. El alto mínimo es la zona de toque. Ni mayúscula automática ni autocorrección: lo que se
 * teclea es parte de un nombre, y el teclado del móvil no tiene que cambiarlo por otra palabra.
 *
 * Historia 27.2 — `/buscar/` lo usa con tres cosas que el filtro no lleva, todas opcionales y sin
 * ellas el campo sale como antes: el `name` que envía su formulario (`nombre`, «q»), un texto de
 * ejemplo (`ejemplo`, el `placeholder`, en la tinta apagada) y la marca `data-consulta` por la que
 * lo encuentran su guion y las pruebas (`consulta`).
 */
interface Props {
  /** El `id` del campo, al que apunta su etiqueta. */
  id: string;
  /** La etiqueta visible: «Escribe parte del nombre.». */
  etiqueta: string;
  /** El `name` del campo, si va en un formulario que lo envía. */
  nombre?: string;
  /** El texto de ejemplo («Por ejemplo: no hay camino»), como `placeholder`. */
  ejemplo?: string;
  /** Si el campo lleva la marca `data-consulta`. */
  consulta?: boolean;
}

const { id, etiqueta, nombre, ejemplo, consulta = false } = Astro.props;
---

<div class="campo-de-busqueda">
  <label for={id}>{etiqueta}</label>
  <input
    id={id}
    name={nombre}
    type="search"
    autocomplete="off"
    autocapitalize="none"
    autocorrect="off"
    spellcheck="false"
    placeholder={ejemplo}
    data-consulta={consulta ? '' : undefined}
  />
</div>

<style>
  label {
    display: block;
    margin-bottom: var(--unidad);
    font-family: var(--sans);
    font-size: var(--pie);
    color: var(--tinta-apagada);
  }

  input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-height: var(--zona-de-toque);
    margin: 0;
    padding: var(--unidad) 0;
    font-family: var(--sans);
    font-size: var(--cuerpo-lg);
    color: var(--tinta);
    background: transparent;
    border: 0;
    border-bottom: var(--grosor-filete) solid var(--contorno);
    border-radius: 0;
    box-shadow: none;
    appearance: none;
  }

  /* El texto de ejemplo, cuando lo hay, en la tinta apagada: no es lo tecleado. */
  input::placeholder {
    color: var(--tinta-apagada);
    opacity: 1;
  }

  /* Sin la cruz ni la lupa nativas de `type="search"`: ni botón ni icono. */
  input::-webkit-search-cancel-button,
  input::-webkit-search-decoration {
    appearance: none;
  }

  /*
   * El filete se engruesa al doble y pasa a siena al recibir el foco, sumado al anillo global de
   * `:focus-visible`. El alto lo da `min-height` con `border-box`, así que el filete más grueso
   * no mueve nada de lo que sigue.
   */
  input:focus {
    border-bottom: calc(var(--grosor-filete) * 2) solid var(--siena);
  }
</style>
