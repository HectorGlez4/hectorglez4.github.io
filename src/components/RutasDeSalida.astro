---
/**
 * Rutas de salida — FR-12, UX-DR67, UX-DR68, UX-DR69, UX-DR101, UX-DR108, UX-DR112, AD-11, AD-19,
 * NFR-13, Historia 24.6.
 *
 * Al pie de la Página de Cita, tras las acciones, tres grupos de lo más cercano a lo más amplio:
 *
 *   · **«De la misma obra»** — hasta `MAX_CITAS_DE_LA_MISMA_OBRA` Citas de su Obra, en el orden
 *     del libro, con la Tarjeta de Cita sin atribución (el contexto ya dice Autor y Obra) y el
 *     cierre «Las {n} citas de {título} ›» hacia la página 1 de la Obra;
 *   · **«Más de {Autor}»** — hasta `MAX_CITAS_RELACIONADAS` Citas del Autor sacadas de otras
 *     Obras, con la Tarjeta que lleva solo la Obra y el cierre «Las {n} citas de {Autor} ›»
 *     hacia su Página de Autor;
 *   · **«Temas»** — los chips de los Temas publicados de la Cita.
 *
 * Qué Citas, cuántas y los recuentos los decide `rutasDeSalidaDeCita` (`src/lib/publicado.ts`),
 * y los textos de los cierres, `src/lib/atribucion.ts`: aquí no se cuenta, ni se ordena, ni se
 * recorta nada (AD-11). La tarjeta es la única Tarjeta de Cita (AD-19) y la fila, la única Fila
 * de bloque, con su glifo «›».
 *
 * **Un grupo vacío no está**: ni rótulo, ni filete, ni hueco. Y sin ninguno no hay `nav`, porque
 * no hay respaldo: los de antes —«Explorar por tema» con los Temas del sitio y «Seguir leyendo»
 * hacia el Autor— se retiraron, y la Atribución de arriba sigue enlazando al Autor y a la Obra.
 *
 * Todo va bajo `data-pagefind-ignore="all"` (NFR-13): aquí aparece el texto de otras Citas, y sin
 * esto un fragmento buscado devolvería también las páginas que lo tienen como ruta de salida.
 *
 * El `nav` se sigue llamando «Seguir leyendo» para el lector de pantalla (`aria-label`): es el
 * nombre del punto de referencia entero —qué ofrece el pie, no uno de sus grupos—, y la sección
 * de respaldo que se llamaba igual es la que se retiró.
 *
 * El `nav` no lleva `data-zona`: cada tarjeta y cada fila declaran la suya en su `<li>` y los
 * chips en su `ul`, la declaración más cercana manda, y una del `nav` no la pintaría nadie.
 *
 * No hay enlace «Ver la ficha del Autor» aparte del cierre: la atribución de arriba ya lleva a
 * su página, y el siena en tres sitios de la misma pantalla deja de señalar.
 */
import { problemaDeRutasDeSalida, type Autor, type RutasDeSalidaDeCita } from '../lib/publicado.ts';
import { cierreDeLaMismaObra, cierreDeMasDelAutor } from '../lib/atribucion.ts';
import { rutaDeLaObra } from '../lib/obras.ts';
import { rutaDeAutor, rutaDeTema } from '../lib/superficies.ts';
import type { Zona } from '../lib/vocabulario.ts';
import Chips from './Chips.astro';
import FilaDeBloque from './FilaDeBloque.astro';
import Rotulo from './Rotulo.astro';
import TarjetaDeCita from './TarjetaDeCita.astro';

interface Props {
  /** El Autor de la Cita: el de «Más de {Autor}» y su cierre. */
  autor: Autor;
  /** Lo que pinta el pie, decidido por `rutasDeSalidaDeCita`. */
  rutas: RutasDeSalidaDeCita;
  /**
   * La Zona de salida interna de «Más de {Autor}» y de su cierre (FR-56, UX-DR111, Historia
   * 23.7). «De la misma obra» lleva la suya, `misma-obra`, y los Chips de Tema, `chip-de-tema`:
   * la escucha del fichero toma la declaración más cercana al enlace. Obligatoria, como en los
   * demás componentes de enlace.
   */
  zona: Zona;
}

const { autor, rutas, zona } = Astro.props;
const { mismaObra, delAutor, temas } = rutas;

/*
 * Un uso roto para la construcción: lo que diga `problemaDeRutasDeSalida` (un grupo vacío, más
 * tarjetas de las que caben, un cierre que cuenta menos de lo que se enseña, una Cita de otra
 * Obra u otro Autor, una tarjeta repetida). `rutasDeSalidaDeCita` no los produce; un uso que no
 * venga de ella sí podría, y el pie diría algo falso. Que ninguna sea la propia ni la de
 * «Siguiente» lo garantiza solo `rutasDeSalidaDeCita`: el componente no recibe ninguna de las dos,
 * y un uso nuevo (la portada, 28.2) la llama a ella.
 */
const problema = problemaDeRutasDeSalida(autor, rutas);
if (problema !== undefined) {
  throw new Error(`RutasDeSalida: en ${Astro.url.pathname}, ${problema}`);
}

const hayAlgo = mismaObra !== undefined || delAutor !== undefined || temas.length > 0;
---

{
  hayAlgo && (
    <nav class="salidas" aria-label="Seguir leyendo" data-pagefind-ignore="all">
      {mismaObra !== undefined && (
        <section class="de-la-misma-obra">
          <Rotulo id="de-la-misma-obra">De la misma obra</Rotulo>
          <ul class="tarjetas">
            {mismaObra.citas.map((otra) => (
              <TarjetaDeCita cita={otra} atribucion="ninguna" zona="misma-obra" />
            ))}
            <FilaDeBloque href={rutaDeLaObra(mismaObra.obra)} zona="misma-obra" avance>{cierreDeLaMismaObra(mismaObra.obra)}</FilaDeBloque>
          </ul>
        </section>
      )}
      {delAutor !== undefined && (
        <section class="mas-del-autor">
          <Rotulo id="mas-del-autor">Más de {autor.nombre}</Rotulo>
          <ul class="tarjetas">
            {delAutor.citas.map((otra) => (
              <TarjetaDeCita cita={otra} atribucion="obra" zona={zona} />
            ))}
            <FilaDeBloque href={rutaDeAutor(autor.slug)} zona={zona} avance>{cierreDeMasDelAutor(autor, delAutor.recuento)}</FilaDeBloque>
          </ul>
        </section>
      )}
      {temas.length > 0 && (
        <section class="temas-de-la-cita">
          <Rotulo id="temas-de-la-cita">Temas</Rotulo>
          <Chips
            enlaces={temas.map((tema) => ({ href: rutaDeTema(tema.slug), nombre: tema.nombre }))}
            zona="chip-de-tema"
          />
        </section>
      )}
    </nav>
  )
}

<style>
  /*
   * La apertura de UX-DR67: 8 × `--unidad` (64 px) en móvil y 12 × (96 px) desde 600 px, el
   * corte de `tokens.css` —si ese corte se mueve, este se mueve con él—. No es `--respiracion`
   * (40 y 64 px), que es otro ritmo; antes de la 24.6 el pie usaba 1,5 × `--respiracion`.
   */
  .salidas {
    margin-top: calc(var(--unidad) * 8);
    padding-top: calc(var(--unidad) * 3);
    border-top: var(--grosor-filete) solid var(--filete);
    max-width: var(--medida-prosa);
  }

  @media (min-width: 600px) {
    .salidas {
      margin-top: calc(var(--unidad) * 12);
    }
  }

  section + section {
    margin-top: calc(var(--unidad) * 4);
  }

  /* Como el listado de la Página de Autor: filete encima de la primera, y cada fila pone el suyo debajo. */
  .tarjetas {
    list-style: none;
    padding: 0;
    margin: calc(var(--unidad) * 2) 0 0;
    border-top: var(--grosor-filete) solid var(--filete);
  }
</style>
