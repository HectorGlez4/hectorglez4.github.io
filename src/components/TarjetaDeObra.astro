---
/**
 * Tarjeta de Obra — FR-12, UX-DR64, UX-DR104, UX-DR108, UX-DR110, Historia 24.4.
 *
 * Lo que la Página de Cita dice de la Obra de la que sale su Cita, tras las acciones —Copiar,
 * Imagen y compartir— y antes de las Rutas de salida (Historia 30.1, UX-DR113, UX-DR122). Hasta
 * la 30.1 iba entre la Línea de la Fuente y Copiar, y a 360 × 640 empujaba Copiar entre 661 y
 * 756 px, fuera de la primera pantalla: quien viene a llevarse la Cita la tiene ahora a mano, y
 * quien quiere el libro ve aquí de cuál es la frase, cuántas citas hay de él y que puede ir a
 * la Obra y a dónde leerla, sin buscarlo dentro de la línea de la Procedencia.
 *
 *   · Rótulo «De la obra», con el nivel que recibe (`nivel`, sin valor por omisión): la Página de
 *     Cita pasa `2`; la portada pasará `3`, bajo «La cita de hoy» (28.2).
 *   · El título de su Ficha de Obra, sin enlace —ya enlaza en la Atribución, y aquí lo hace la
 *     fila— y sin recortar nunca (NFR-12).
 *   · «{dueño} · {año} · {n} citas» —el Autor de la Obra o, desde la Historia 35.4, su Personaje
 *     (`obra.dueño`)—: lo compone `contenidoDeTarjetaDeObra`, en
 *     `src/lib/atribucion.ts`, con el año y el recuento de la Obra resuelta. Aquí no se cuenta
 *     ni se deriva nada (AD-11).
 *   · Una o dos Filas de bloque, apiladas (UX-DR65):
 *       – primero, si hay a dónde ir, «Siguiente…» (Historia 24.5): «Siguiente cita de esta obra»
 *         en el orden del libro, o, en una Obra de una sola Cita, «Siguiente cita sobre {tema}» a
 *         la de otro Autor que le sigue en el listado de su primer Tema publicado. Lo decide
 *         `siguienteCita` (`src/lib/publicado.ts`) y lo dice `textoDeSiguiente`
 *         (`src/lib/atribucion.ts`); llega por `siguiente`, y sin él la fila no está y la tarjeta
 *         es la de la 24.4 byte a byte. Va antes que «Ver la obra» en el marcado, y por eso en
 *         el orden de tabulación (UX-DR63);
 *       – después, la de la página 1 de la Obra —se indexe o no, esté congelada o no: el
 *         `noindex` y la congelación no alcanzan a la navegación—, que promete «y dónde leerla»
 *         solo si alguna de sus Citas está cotejada (`edicionCotejada`).
 *     Las `ediciones` de la ficha y la afiliación no cuentan en ninguna: la tarjeta sale
 *     idéntica byte a byte con el Modelo encendido o apagado (FR-35), y no aloja ninguno.
 *
 * Sin Obra no pinta nada —ni sección, ni rótulo, ni hueco—, como `Fuente.astro` sin Fuente.
 *
 * **No vive dentro de `BloqueDeCita.astro`** porque ese bloque lo comparten la portada y el
 * 404, y ninguna de las dos cambia con esta historia: la portada la recibe en la 28.2, con su
 * propio nivel, y el 404 no la lleva nunca.
 *
 * Fuera de Pagefind con `all` y no con el atributo a secas: la tarjeta nombra el título y el
 * Autor, que el índice no debe recoger ni como texto ni como filtro desde cada Página de Cita
 * (NFR-13). Sin guion: todo sale del build.
 *
 * **En el Panel de bloque de la Obra** (Historia 36.1, DESIGN.md v9.3): la `section` va dentro de
 * `PanelDeBloque` con `familia="obra"`, que le da el tinte `--contenedor-obra`, el radio, el relleno
 * y el Rótulo de panel, y deja de llevar filete de apertura; entre sus dos filas, solo la divisoria
 * `--filete-obra`. Sigue en tinta y sin siena, y su hoja sigue sin fondo ni radio propios: son del
 * panel. Los 4 × `--unidad` de lo de arriba los pone la Página de Cita al panel. Solo la usa la
 * Página de Cita: la portada compone la suya, que sigue plana.
 */
import Rotulo from './Rotulo.astro';
import PanelDeBloque from './PanelDeBloque.astro';
import FilaDeBloque from './FilaDeBloque.astro';
import type { Cita, SiguienteCita } from '../lib/publicado.ts';
import type { Dueño } from '../lib/obras.ts';
import { rutaDeLaObra } from '../lib/obras.ts';
import { contenidoDeTarjetaDeObra, textoDeSiguiente } from '../lib/atribucion.ts';
import { rutaDeCita } from '../lib/superficies.ts';

interface Props {
  cita: Cita;
  /**
   * El dueño de la Obra de la Cita, con su nombre —su Autor o su Personaje, el de `obra.dueño`, y
   * ningún otro (Historia 35.4)—, o `undefined` si la Cita no tiene Obra.
   */
  dueño: (Dueño & { nombre: string }) | undefined;
  /**
   * El nivel del rótulo «De la obra». Obligatorio y sin valor por omisión: depende de bajo qué
   * encabezado cuelga la tarjeta, y eso solo lo sabe quien la usa.
   */
  nivel: 2 | 3;
  /**
   * A dónde lleva «Siguiente…», o `undefined` si no hay a dónde ir (Historia 24.5). Obligatorio y
   * sin `?`: cada uso declara si lo hay —la portada dirá el suyo (28.2)—, y uno nuevo que lo
   * olvide no pasa `astro check`.
   */
  siguiente: SiguienteCita | undefined;
}

const { cita, dueño, nivel, siguiente } = Astro.props;

const obra = cita.obra;

/*
 * Que la Tarjeta nombre a otro dueño sería atribuirle la Obra a quien no la firma. La integridad
 * del conjunto publicable garantiza que toda Obra resuelve su dueño, así que esto es un uso roto,
 * no un caso que pintar: detiene la construcción.
 */
if (
  obra === undefined
    ? dueño !== undefined
    : dueño === undefined || dueño.tipo !== obra.dueño.tipo || dueño.slug !== obra.dueño.slug
) {
  throw new Error(
    `TarjetaDeObra: la Cita «${cita.slug}» se pinta en ${Astro.url.pathname} con el dueño ` +
      `${dueño === undefined ? '«ninguno»' : `${dueño.tipo} «${dueño.slug}»`}, pero su Obra es de ` +
      `${obra === undefined ? '«nadie: no tiene Obra»' : `${obra.dueño.tipo} «${obra.dueño.slug}»`}.`,
  );
}

const contenido = obra === undefined || dueño === undefined ? undefined : contenidoDeTarjetaDeObra(dueño, obra);

/*
 * Historia 24.5 — «Siguiente…» lo decide `siguienteCita`, que nunca devuelve la propia Cita, por
 * la Obra solo da una hermana y sin Obra no da nada. Un uso que pase otra cosa —la portada dirá
 * el suyo (28.2)— es un uso roto: una fila a la misma página, «Siguiente cita de esta obra» a
 * otro libro, o una navegación calculada que la tarjeta sin Obra tiraría en silencio. Detiene
 * la construcción, como el Autor ajeno.
 */
if (siguiente !== undefined) {
  const roto =
    obra === undefined
      ? 'la Cita no tiene Obra'
      : siguiente.cita.slug === cita.slug
        ? 'lleva a la propia Cita'
        : siguiente.por === 'obra' && siguiente.cita.obra?.nombre !== obra.nombre
          ? `lleva a «${siguiente.cita.slug}», de otra Obra que «${obra.nombre}»`
          : undefined;
  if (roto !== undefined) {
    throw new Error(
      `TarjetaDeObra: «Siguiente…» de la Cita «${cita.slug}» en ${Astro.url.pathname}: ${roto}.`,
    );
  }
}
---

{/*
  * Las partes de los hechos van pegadas, sin espacio entre etiquetas: Astro conserva uno donde
  * hay salto de línea, y la vista diría «Séneca  · 49». El punto medio es decoración y el lector
  * oye una coma; ninguno al principio ni al final, y ninguno de sobra cuando falta el año.
  */}
{
  obra !== undefined && contenido !== undefined && (
    <PanelDeBloque familia="obra" cierre="fila"><section class="tarjeta-de-obra" aria-labelledby="de-la-obra" data-pagefind-ignore="all">
      <Rotulo id="de-la-obra" nivel={nivel}>De la obra</Rotulo>
      <p class="titulo">{obra.titulo}</p>
      <p class="hechos">{contenido.hechos.map((parte, i) => (<>{i > 0 && (<><span aria-hidden="true"> · </span><span class="solo-para-lectores">, </span></>)}{parte}</>))}</p>
      <ul class="filas">{siguiente !== undefined && (<FilaDeBloque href={rutaDeCita(siguiente.cita.slug)} zona="siguiente" avance>{textoDeSiguiente(siguiente)}</FilaDeBloque>)}<FilaDeBloque href={rutaDeLaObra(obra)} zona="tarjeta-de-obra" avance>{contenido.fila}</FilaDeBloque></ul>
    </section></PanelDeBloque>
  )
}

<style>
  /*
   * En tinta y sin siena. Desde la 36.1 la delimita el Panel de bloque de la Obra, que pone el
   * fondo, el radio y el aire: aquí ni filete de apertura, ni fondo, ni radio.
   */
  .tarjeta-de-obra {
    max-width: var(--medida-prosa);
  }

  /*
   * Inter, nunca la serif: el título de una Obra no es nombre de Autor ni de Tema. Sin segundo
   * tamaño ni máximo de líneas: un título largo reparte sus líneas y parte palabras antes que
   * desbordar, con la partición del `h1` de la Cabecera de Obra.
   */
  .titulo {
    margin: var(--unidad) 0 0;
    font-family: var(--sans);
    font-size: var(--cuerpo-lg);
    font-weight: var(--peso-fuerte);
    /*
     * Historia 26.12 — excepción de DESIGN.md § Typography: el título de la Tarjeta de Obra toma el
     * interlineado de `author` (1,4) y no el de su cuerpo. No es un descuido: la nombra, por fichero
     * y selector, `tests/unit/tipografia-en-tokens.test.ts`.
     */
    line-height: var(--interlineado-autor);
    color: var(--tinta);
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .hechos {
    margin: var(--unidad) 0 0;
    font-family: var(--sans);
    font-size: var(--pie);
    font-weight: var(--peso-regular);
    line-height: var(--interlineado-pie);
    color: var(--tinta-apagada);
  }

  /* Sin filete encima de la primera: entre «Siguiente…» y «Ver la obra», solo la divisoria de la
   * Obra que pone el panel, y ninguna bajo la última (UX-DR65, DESIGN.md v9.3). */
  .filas {
    list-style: none;
    margin: calc(var(--unidad) * 2) 0 0;
    padding: 0;
  }
</style>
