---
/**
 * Atribución — UX-DR8, FR-2.
 *
 * El nombre del Autor va en el token `author` (Inter, versalitas por letter-spacing) y
 * enlazado **en tinta, no en siena**: el nombre no es una llamada a la acción, es
 * información. La Procedencia va debajo en `caption` y tinta apagada.
 *
 * La regla que no se puede negociar: cuando falta la obra, se dice «Sin obra
 * documentada». El bloque nunca se omite en silencio, y nunca se muestra una procedencia
 * inferida o aproximada. Presencia de la ausencia.
 */
import type { Cita, Autor } from '../lib/publicado.ts';

interface Props {
  cita: Cita;
  autor: Autor;
}

const { cita, autor } = Astro.props;
const { obra, año, referencia } = cita.procedencia;

/**
 * La línea de procedencia. Se compone con lo que consta y solo con lo que consta.
 * El esquema garantiza que algo hay —una Cita sin nada documentado no se publica—, pero
 * la obra puede faltar, y entonces se declara que falta.
 */
const frases: string[] = [];

if (obra !== undefined && año !== undefined) frases.push(`${obra}, ${año}`);
else if (obra !== undefined) frases.push(obra, 'Sin año documentado');
else if (año !== undefined) frases.push('Sin obra documentada', `Año ${año}`);
else frases.push('Sin obra documentada');

if (referencia !== undefined) frases.push(referencia);

/**
 * UX-DR21 — frases completas con punto final. Se compone como oraciones separadas por
 * punto y espacio, no encadenadas con un separador: una línea como «Sin obra documentada.
 * · Lema de sus escritos» mezcla dos convenciones y deja la segunda mitad sin terminar.
 * El punto se añade aquí y no se escribe en el corpus, para que el dato guardado sea el
 * dato y no una frase.
 */
const procedencia = frases.map((f) => (/[.?!]$/.test(f) ? f : `${f}.`)).join(' ');
---

<p class="autor">
  <a href={`/autor/${autor.slug}`}>{autor.nombre}</a>
</p>
<p class="procedencia">{procedencia}</p>

<style>
  .autor {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .autor a {
    /* En tinta, no en siena: el nombre es información, no una acción. */
    color: var(--tinta);
    text-decoration: none;

    /*
     * UX-DR22 — zona de toque de 44px. El nombre se compone a 13px, así que su caja de
     * texto mide unos 18: en móvil es un blanco difícil justo para el enlace que abre
     * la ruta de salida principal. El relleno crece el área sensible y el margen
     * negativo lo devuelve todo a su sitio, de modo que el ritmo vertical de 8px no se
     * mueve ni un píxel.
     */
    display: inline-block;
    padding-block: 13px;
    margin-block: -13px;
  }

  .autor a:hover {
    text-decoration: underline;
  }

  .procedencia {
    margin: var(--unidad) 0 0;
    font-family: var(--sans);
    font-size: var(--pie);
    font-weight: 400;
    line-height: 1.5;
    color: var(--tinta-apagada);
  }
</style>
