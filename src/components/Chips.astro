---
/**
 * Chips de navegación — UX-DR12.
 *
 * La lista de chips que llevan a un Tema. (Hasta la Historia 24.6 llevaba también, como último
 * recurso de las Rutas de salida, a un Autor; ese respaldo se retiró.) Vive aparte desde la
 * Historia 22.4 porque la usan dos superficies —las Rutas de salida de la Página de Cita y los
 * Temas de la Página de Obra— y con el CSS copiado en las dos el chip acabaría teniendo dos
 * aspectos a la primera corrección.
 *
 * Solo la lista: el rótulo que la precede y la sección que la envuelve son de quien la usa.
 */
import type { Zona } from '../lib/vocabulario.ts';

interface Props {
  enlaces: readonly { href: string; nombre: string }[];
  /**
   * La Zona de salida interna de sus enlaces (FR-56, UX-DR111, Historia 23.7). Obligatoria: cada
   * uso dice desde qué zona se sale, y un uso nuevo que la olvide no pasa `astro check`.
   */
  zona: Zona;
}

const { enlaces, zona } = Astro.props;
---

<ul class="chips" data-zona={zona}>
  {
    enlaces.map((enlace) => (
      <li>
        <a class="chip" href={enlace.href}>
          {enlace.nombre}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    /* UX-DR22 — 8px de separación entre zonas de toque. */
    gap: var(--unidad);
    margin: calc(var(--unidad) * 2) 0 0;
    padding: 0;
  }

  /* UX-DR12 — fondo `surface-container`, radio 6px, nunca en siena. */
  .chip {
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    padding-inline: calc(var(--unidad) * 2);
    background: var(--contenedor);
    border-radius: var(--radio-tarjeta);
    font-family: var(--serif);
    font-size: var(--cuerpo-md);
    color: var(--tinta);
    text-decoration: none;
    /* NFR-8, Historia 26.9 — el nombre del Tema o de la Colección es del Corpus: con el texto al
     * 200 % una palabra más ancha que la columna se parte. El chip es un elemento flexible y
     * `break-word` no rebaja su ancho mínimo; `anywhere` sí. */
    overflow-wrap: anywhere;
    transition: background-color 150ms;
  }

  .chip:hover {
    background: var(--contenedor-alto);
  }
</style>
