---
/**
 * «Dónde leer esta obra» — Historias 22.6 y 32.4, UX-DR124, UX-DR125, UX-DR127, FR-54.
 *
 * De qué edición se tomó el texto de las Citas de la Obra, bajo qué licencia y dónde leerla
 * entera, **plegado** en `Desplegable.astro` (la primitiva única: este componente nunca escribe su
 * `<details>`) y primero de los desplegables entre la Cabecera y el listado de la página 1. El
 * rótulo del `<summary>` es `ROTULO_DE_DONDE_LEER`. Recibe el resumen ya calculado por `dondeLeer`
 * (`src/lib/obras.ts`) en `getStaticPaths`; aquí no se compone más prosa que la plantilla fija de
 * la línea, y la frase de lo tomado la redacta `textoDeLoTomado` (`src/lib/atribucion.ts`).
 *
 * Dos formas, y ninguna afirma un cotejo que no ocurrió (FR-54):
 *
 *   · con Fuentes: el grupo «Gratis» (`RotuloDeGrupo.astro`), con una línea por Fuente y
 *     traducción, cada una seguida de cuántas Citas de la Obra se tomaron de ella. Siempre en
 *     positivo: nunca se dice cuántas no tienen documento;
 *   · ninguna Cita con Fuente: solo la frase que lo dice, sin grupo ni enlace, porque un rótulo
 *     que nombra una edición encima de su ausencia la afirmaría.
 *
 * Historias 22.9 y 33.2 — con la afiliación encendida y admitida en la ruta, y la familia Obra
 * sin congelar (lo pregunta la página, que es quien puede importar `src/lib/ingreso.ts`), llegan
 * los grupos de `enVenta` ya repartidos —«Electrónica» y luego «Impresa», por tienda— y, **solo si
 * hay alguna línea cotejada**, se pintan tras «Gratis», dentro del desplegable y en un único
 * `data-ingreso`: nunca van solos ni en lugar de la cotejada (FR-54). Sin `enVenta`, todo lo de
 * fuera de su `data-ingreso` es byte a byte igual.
 *
 * Fuera del índice de Pagefind lo pone quien lo usa (el contenedor de los desplegables, con
 * `data-pagefind-ignore="all"`): «Licencia CC BY-SA» no puede ser un resultado de búsqueda en
 * cada Obra. Los enlaces sacan del sitio: sin `data-zona` ni `data-sin-zona`.
 *
 * La hoja de estilo se queda: este componente se pinta en toda página 1 de Obra, así que su hoja no deja
 * hueco en ninguna página que no lo use.
 */
import Desplegable from './Desplegable.astro';
import EdicionesEnVenta from './EdicionesEnVenta.astro';
import RotuloDeGrupo from './RotuloDeGrupo.astro';
import { ROTULO_DE_DONDE_LEER } from '../lib/obras.ts';
import { textoDeLoTomado } from '../lib/atribucion.ts';
import type { LineaDondeLeer, ResumenDondeLeer } from '../lib/obras.ts';
import type { GrupoDeEdiciones } from '../lib/ediciones.ts';

interface Props {
  resumen: ResumenDondeLeer;
  /** Las ediciones en venta ya repartidas por formato (33.2), y el Modelo que las pone (22.9). */
  enVenta?: {
    id: string;
    grupos: readonly GrupoDeEdiciones[];
  };
}

const { lineas, total } = Astro.props.resumen;
const { enVenta } = Astro.props;

/** Lo que sigue al nombre de la Fuente, con la puntuación de la plantilla. */
function resto(linea: LineaDondeLeer): string {
  const repartida = linea.paginas > 1 ? `, repartida en ${linea.paginas} páginas` : '';
  const traduccion =
    linea.traduccion === undefined
      ? ''
      : `, en la traducción de ${linea.traduccion.traductor}` +
        (linea.traduccion.año !== undefined ? ` (${linea.traduccion.año})` : '');
  const licencia = linea.licencia !== undefined ? ` Licencia ${linea.licencia}.` : '';
  return `${repartida}${traduccion}.${licencia}`;
}
---

<Desplegable rotulo={ROTULO_DE_DONDE_LEER}>
  {
    lineas.length === 0 ? (
      <p class="sin-cotejo">Ninguna de sus citas tiene todavía documento cotejado.</p>
    ) : (
      <>
        <div class="grupo">
          <RotuloDeGrupo>Gratis</RotuloDeGrupo>
          {lineas.map((linea) => (
            <>
              <p class="linea">
                {linea.enlace !== undefined ? (
                  <a href={linea.enlace} rel="noopener nofollow">{linea.nombre}</a>
                ) : (
                  linea.nombre
                )}{resto(linea)}
              </p>
              <p class="linea tomado">{textoDeLoTomado(linea.citas, total)}</p>
            </>
          ))}
        </div>
        {enVenta !== undefined && enVenta.grupos.length > 0 && (
          <EdicionesEnVenta id={enVenta.id} grupos={enVenta.grupos} />
        )}
      </>
    )
  }
</Desplegable>

<style>
  /*
   * UX-DR125, UX-DR127 — el primer grupo va a 2 × `--unidad` del `<summary>`, que lo da el
   * relleno del contenido del desplegable (el grupo no añade margen arriba); 3 × entre grupos
   * (los de «Electrónica» e «Impresa», 33.2, lo llevan en su atributo `style`) y 1 × del
   * rótulo de grupo a cada línea y entre líneas y frases. Peso e
   * interlineado son los de la Línea de la Fuente.
   */
  .grupo + .grupo {
    margin-top: calc(var(--unidad) * 3);
  }

  .linea,
  .sin-cotejo {
    font-family: var(--sans);
    font-size: var(--pie);
    line-height: var(--interlineado-pie);
    color: var(--tinta-apagada);
  }

  .linea {
    margin: var(--unidad) 0 0;
  }

  .sin-cotejo {
    margin: 0;
  }

  /*
   * El nombre de la Fuente saca del sitio: siena, como todo enlace de salida (DESIGN.md
   * § Colors), y subrayado siempre, no al pasar el cursor.
   */
  .linea a {
    color: var(--siena);
    text-decoration-line: underline;
    text-decoration-thickness: var(--grosor-filete);
  }
</style>
