---
/**
 * Datos estructurados de la Página de Cita — NFR-3.
 *
 * `Quotation` con su `creator`, que es el tipo que schema.org define exactamente para
 * esto. Se emite como `application/ld+json`, que no es JavaScript ejecutable: no lo
 * descarga ni lo ejecuta el navegador, así que no toca AD-6.
 *
 * Solo se declara lo que consta. Una `Quotation` con `isPartOf` apuntando a una obra
 * inventada sería exactamente la procedencia inferida que FR-2 prohíbe, con el agravante
 * de que un buscador se la creería.
 */
import type { Cita, Autor } from '../lib/publicado.ts';

interface Props {
  cita: Cita;
  autor: Autor;
  canonica: string;
}

const { cita, autor, canonica } = Astro.props;
const { obra, año } = cita.procedencia;

const datos: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Quotation',
  '@id': canonica,
  url: canonica,
  text: cita.texto,
  inLanguage: 'es',
  creator: {
    '@type': 'Person',
    name: autor.nombre,
    url: new URL(`/autor/${autor.slug}`, canonica).href,
    ...(autor.añoNacimiento !== undefined ? { birthDate: String(autor.añoNacimiento) } : {}),
    deathDate: String(autor.añoFallecimiento),
  },
};

/*
 * De dónde se tomó el texto, también para quien lee el marcado y no la página.
 *
 * `isBasedOn` es lo que schema.org define para «esta obra deriva de aquella», y aquí es
 * literal: el texto se tomó de ese documento. No se declara `sameAs` —que afirmaría que
 * las dos URLs son la misma cosa— ni `citation`, que es para una obra citada *dentro*.
 *
 * Solo cuando consta, como el resto: una Cita sin Fuente declarada no emite el campo en
 * vez de emitirlo vacío.
 */
if (cita.fuente !== undefined) {
  datos.isBasedOn = {
    '@type': 'CreativeWork',
    url: cita.fuente.url,
    ...(cita.fuente.nombre !== undefined ? { publisher: { '@type': 'Organization', name: cita.fuente.nombre } } : {}),
    ...(cita.fuente.licencia !== undefined ? { license: cita.fuente.licencia } : {}),
  };
}

if (obra !== undefined) {
  datos.isPartOf = {
    '@type': 'CreativeWork',
    name: obra,
    ...(año !== undefined ? { datePublished: String(año) } : {}),
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(datos)} is:inline />
