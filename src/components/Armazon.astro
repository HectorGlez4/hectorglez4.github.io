---
/**
 * Armazón común de todas las superficies públicas.
 *
 * La cabecera — Historia 26.5 (UX-DR54, UX-DR55, UX-DR101, UX-DR102, UX-DR105, UX-DR106 y
 * UX-DR112, que enmienda la UX-DR29 de la 2.1): «Sabiduría de Bolsillo · Autores · Obras ·
 * Buscar». La marca lleva a la portada y una navegación «Principal» lleva a los dos Directorios
 * y a la búsqueda, con las rutas de `src/lib/superficies.ts`; así toda Página de Autor y toda
 * página 1 de Obra quedan a dos saltos de la portada (FR-55; las 2+ cuelgan de su página 1).
 * Sigue sin migas de pan: no hay jerarquía que reflejar,
 * el visitante entra por una hoja y se mueve lateralmente entre hojas. La marca no es un `h1`
 * (eso es de la 28.1).
 *
 * NFR-2 — el contenido llega en el HTML inicial. AD-6 — en línea van las islas y el arranque
 * de la medición; lo que se descarga está en la lista cerrada de `src/lib/guiones.ts`.
 */
import { Font } from 'astro:assets';
import Medicion from './Medicion.astro';
import DondeSeguirnos from './DondeSeguirnos.astro';
import { LADO_DE_IOS, MARCA, TAMANOS_DEL_ICONO } from '../lib/marca.ts';
import {
  consecuenciasDe,
  declararRutasIndexables,
  rutaDeLaBusqueda,
  rutaDeLaPortada,
  rutaDelDirectorioDeAutores,
  rutaDelDirectorioDeObras,
  rutaNormalizada,
} from '../lib/superficies.ts';
import { ATRIBUTO_DE_INDEXABLE } from '../lib/medicion.ts';
import { conjuntoPublicable, rutasIndexables } from '../lib/publicado.ts';
import { FILTRO_DE_TIPO, tipoDeOpenGraph, type TipoDeResultado } from '../lib/tipoDeResultado.ts';
import '../styles/tokens.css';
import { PALETA } from '../lib/lienzo.ts';

interface Props {
  titulo: string;
  /**
   * Qué clase de resultado es esta página en la búsqueda propia.
   *
   * El valor y su rótulo salen los dos de `src/lib/tipoDeResultado.ts`: la unión se deriva
   * de la tabla de rótulos, así que un tipo sin rótulo no compila. Sin valor, un resultado
   * cae al tipo por omisión, y una Página de Colección se leería como si fuera una Cita.
   *
   * Viaja como **filtro** de Pagefind (`FILTRO_DE_TIPO`), nunca como metadato: la metadata se
   * busca, y buscar «obra» devolvía toda Obra aunque no lo dijera (Historia 26.2). Este armazón
   * es su único emisor, y solo en una página que entra en la búsqueda propia.
   *
   * Esto **no** decide si la página se indexa: eso sale entero de `src/lib/superficies.ts`.
   */
  tipo?: TipoDeResultado;
  descripcion: string;
  /**
   * Ruta de la página, sin dominio. Compone la canónica de NFR-1 **y** es lo que decide
   * si la página se indexa, dentro y fuera.
   *
   * Hasta la Historia 12.1 esas dos decisiones llegaban aquí como banderas sueltas
   * —`noIndexar` y `fueraDeLaBusqueda`—, y había que acordarse de poner las dos juntas.
   * No se hizo: `/404` y `/buscar` pedían `noindex` al buscador de fuera y seguían en el
   * índice del de dentro. Ahora las dos salen de la declaración única de
   * `src/lib/superficies.ts`, así que no hay dos valores que puedan discrepar.
   */
  ruta: string;
  /**
   * Ruta de la Tarjeta Social de esta página — FR-19.
   *
   * Sin ella la página no declara imagen y la previsualización sale desnuda. La portada
   * y los listados no la llevan todavía: la Épica 10 la pide para toda **Cita**
   * publicada, que es la unidad que se comparte.
   */
  tarjeta?: string;
}

const { titulo, descripcion, ruta, tipo, tarjeta } = Astro.props;
const canonica = new URL(ruta, Astro.site).href;

/*
 * Las consecuencias de la declaración, derivadas de la ruta. `consecuenciasDe` **rompe el
 * build** si nadie ha declarado esta superficie: una página nueva sin declaración no pasa
 * desapercibida, se para aquí y el mensaje dice qué fichero tocar.
 *
 * Historia 23.1 — de ahí salen también las vistas que emite la página, al `data-vistas` del
 * `<html>`, y si carga el fichero de medición. Ninguna página elige su vista: la prop `vista`
 * que las páginas pasaban hasta la 23.1 era una segunda copia de lo que ya decía la
 * declaración, y cada página la recalculaba con su `currentPage === 1`.
 */
/*
 * Historia 22.4 — si una Página de Obra se indexa depende del Corpus (FR-52), y
 * `superficies.ts` no lo calcula: lo recibe. El empaquetado de las páginas carga su propia
 * instancia de ese módulo —la de la configuración la declara `integraciones/indexables.ts`—, así
 * que aquí se le declara la lista antes de preguntar. Sin ella, `consecuenciasDe` rompe ante una
 * Obra en vez de adivinar. La lista se calcula una vez por conjunto.
 */
declararRutasIndexables(rutasIndexables(await conjuntoPublicable()));
const { noIndexar, enLaBusquedaPropia, vistas, cargaLaMedicion, marcaDeObra } = consecuenciasDe(ruta);
/*
 * Historia 23.9 — la marca de la vista de Obra, al `<html>` junto a `data-vistas`, y solo en la
 * página 1 de una Obra: sale de la misma `consecuenciasDe` que el `noindex` de arriba, así que dice
 * lo mismo que él, y el nombre del atributo es el que lee el fichero de medición
 * (`ATRIBUTO_DE_INDEXABLE`). La comprobación de `astro:build:done` lo coteja en `dist/`. Se escribe
 * también sin punto final, como `data-vistas`.
 */
const marcaDeLaObra = marcaDeObra === undefined ? {} : { [ATRIBUTO_DE_INDEXABLE]: marcaDeObra };
// Absoluta y no relativa: una previsualización se resuelve en el servidor de la red, que
// no tiene la página delante para completar la ruta.
const imagenSocial = tarjeta === undefined ? undefined : new URL(tarjeta, Astro.site).href;

/*
 * Historia 26.5 — `aria-current="page"` en el enlace de la cabecera cuya página es esta, y en
 * ningún otro: se comparan rutas normalizadas, así que la marca lo lleva solo en la portada y
 * «Buscar» en `/buscar/` (lo buscado va en la cadena de consulta, que no es parte de la ruta).
 */
const rutaDeEstaPagina = rutaNormalizada(ruta);
const actualSi = (destino: string) => (rutaNormalizada(destino) === rutaDeEstaPagina ? 'page' : undefined);
const portada = rutaDeLaPortada();
const directorioDeAutores = rutaDelDirectorioDeAutores();
const directorioDeObras = rutaDelDirectorioDeObras();
const busqueda = rutaDeLaBusqueda();
---

<!doctype html>
<!-- UX-DR27 — idioma `es` sin variante regional. -->
<html lang="es" data-vistas={vistas.length > 0 ? vistas.join(' ') : undefined} {...marcaDeLaObra}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {/*
      * El canal de la Cita del Día. Va en TODAS las superficies y no solo en la portada:
      * quien llega por un buscador aterriza en una Página de Cita, y es ahí donde decide
      * si quiere seguir recibiéndolas. Ofrecérselo solo en la portada sería ofrecérselo
      * a quien ya llegó por su cuenta.
      */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${MARCA} — la Cita del Día`}
      href={new URL('/rss.xml', Astro.site).href}
    />
    {noIndexar && <meta name="robots" content="noindex, follow" />}
    {/*
      * El icono del sitio, en las tres formas que hacen falta.
      *
      * El SVG lo prefiere cualquier navegador moderno, pero **no basta**: el icono que
      * Google pone junto al resultado de búsqueda quiere un cuadrado múltiplo de 48, y con
      * solo el vector declarado el sitio salía sin icono en la lista de resultados. Un
      * resultado sin marca al lado, en un sitio cuyo argumento es la procedencia
      * documentada, es exactamente la impresión que no interesa dar.
      *
      * `sizes` va explícito en los PNG porque es lo que deja elegir sin descargar los dos,
      * y `apple-touch-icon` va aparte porque iOS no mira los `rel="icon"`: sin él, añadir
      * el sitio a la pantalla de inicio guarda una captura de la página.
      *
      * Las rutas las publica `src/pages/icono/[tamano].png.ts` a partir de la misma marca, y
      * los lados se recorren desde `TAMANOS_DEL_ICONO` en vez de repetirse aquí: escritos a
      * mano, quitar un lado de la tupla dejaba un `<link>` apuntando a un 404 con el build
      * en verde, que es la divergencia que `superficies.ts` existe para impedir.
      */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {TAMANOS_DEL_ICONO.filter((lado) => lado !== LADO_DE_IOS).map((lado) => (
      <link rel="icon" href={`/icono/${lado}.png`} type="image/png" sizes={`${lado}x${lado}`} />
    ))}
    <link
      rel="apple-touch-icon"
      href={`/icono/${LADO_DE_IOS}.png`}
      sizes={`${LADO_DE_IOS}x${LADO_DE_IOS}`}
    />
    {/* El color con el que el navegador tiñe su interfaz: el papel del sitio, no el suyo. */}
    <meta name="theme-color" content={PALETA.papel} />

    {/*
      * Metadatos de previsualización — FR-19. `og:` lo leen casi todas las redes y
      * mensajerías; `twitter:card` lo necesita X para elegir el formato grande, y sin
      * él muestra la miniatura cuadrada aunque la imagen sea apaisada.
      */}
    <meta property="og:type" content={tipoDeOpenGraph(tipo)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    {imagenSocial !== undefined && (
      <>
        <meta property="og:image" content={imagenSocial} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={imagenSocial} />
      </>
    )}
    <Font cssVariable="--fuente-serif" preload />
    <Font cssVariable="--fuente-sans" preload />
    {/*
      * Historia 23.1 — el arranque de la medición va antes de lo que traiga cada página: abre la
      * cola `__medir` antes de cualquier guion que la llame, también uno que una página pusiera
      * en su cabeza. `tests/unit/medicion.test.ts` exige que sea el primer guion en línea.
      */}
    <Medicion carga={cargaLaMedicion} />
    <slot name="cabeza" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido.</a>

    {/*
      * Historia 23.7 — la Zona de salida interna de la marca y de los tres enlaces de la
      * navegación «Principal» (Historia 26.5, UX-DR111): la lleva el contenedor y nada de dentro
      * la tapa. El enlace de salto de arriba no la lleva: es un ancla de la propia página, y eso
      * no es salida.
      *
      * Historia 26.5 — cada punto medio va **dentro** del `<li>` del enlace anterior, oculto al
      * lector de pantalla: la lista sigue teniendo tres elementos y, si los enlaces se parten en
      * otra fila, ninguna empieza por «·». Es un glifo tipográfico, no un icono.
      */}
    <header class="cabecera contenedor" data-zona="cabecera">
      <a class="marca" href={portada} aria-current={actualSi(portada)}>{MARCA}</a>
      <nav aria-label="Principal">
        <ul class="principal" role="list">
          <li>
            <a class="enlace-en-tinta" href={directorioDeAutores} aria-current={actualSi(directorioDeAutores)}>Autores</a><span class="punto" aria-hidden="true">·</span>
          </li>
          <li>
            <a class="enlace-en-tinta" href={directorioDeObras} aria-current={actualSi(directorioDeObras)}>Obras</a><span class="punto" aria-hidden="true">·</span>
          </li>
          <li>
            <a class="buscar" href={busqueda} aria-current={actualSi(busqueda)}>Buscar</a>
          </li>
        </ul>
      </nav>
    </header>

    {/*
      * Pagefind indexa solo lo que hay dentro de `data-pagefind-body`. Sin esto indexaba
      * también la cabecera y el pie, y buscar «sabiduría» devolvía las 53 páginas del
      * sitio porque la marca aparece en todas.
      *
      * Y quién lo lleva no se decide aquí: sale de la misma declaración que el `noindex`
      * de arriba, así que el buscador de dentro y el de fuera no pueden discrepar.
      *
      * Historia 26.2 — el tipo del resultado va como filtro (`data-pagefind-filter`), que no
      * casa como texto, y no como `data-pagefind-meta`, que desde Pagefind 1.5 se busca. Solo
      * lo lleva una página con `data-pagefind-body`: sin cuerpo no hay resultado que rotular.
      */}
    <main
      id="contenido"
      data-pagefind-body={enLaBusquedaPropia ? true : undefined}
      data-pagefind-ignore={enLaBusquedaPropia ? undefined : true}
      data-pagefind-filter={enLaBusquedaPropia && tipo ? `${FILTRO_DE_TIPO}:${tipo}` : undefined}
    >
      <slot />
    </main>

    <footer class="pie contenedor">
      <p>
        Citas de dominio público, con su procedencia documentada cuando consta.
      </p>
      <DondeSeguirnos />
    </footer>
  </body>
</html>

<style>
  /*
   * UX-DR24 — el orden de tabulación es el orden de lectura. El enlace de salto va
   * primero en el marcado y solo se ve al recibir foco: sin él, quien navega con teclado
   * recorre la cabecera entera en cada página antes de llegar a la Cita.
   */
  .saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--papel);
    color: var(--siena);
    padding: var(--unidad) calc(var(--unidad) * 2);
    z-index: 1;
  }

  .saltar:focus {
    left: var(--margen);
  }

  /*
   * El ancho y el margen lateral vienen de `.contenedor`, compartido con el resto.
   *
   * Historia 26.5 (UX-DR55, UX-DR102) — por debajo de 600px, dos filas: la marca en la suya y
   * los tres enlaces debajo, con `--unidad` de aire arriba, entre las filas y abajo, así que la
   * zona de la marca queda a 8px de las de los enlaces: 8 + 44 + 8 + 44 + 8 + 1 = 113px. Desde
   * 600px, una fila, con 2 × `--unidad` de aire. Nada lleva `white-space: nowrap`: con el texto
   * al 200 % a 320px la marca y los enlaces se parten y nunca desbordan (NFR-8).
   */
  .cabecera {
    display: flex;
    flex-direction: column;
    gap: var(--unidad);
    padding-block: var(--unidad);
    /* UX-DR13 — el filete de 1px es el único separador del sistema. */
    border-bottom: var(--grosor-filete) solid var(--filete);
  }

  /*
   * La marca, enlace de bloque **a su ancho**: su zona de toque es su texto con 44px de alto,
   * no la fila entera, para que un toque a su derecha no lleve a la portada.
   */
  .marca {
    align-self: flex-start;
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: var(--peso-fuerte);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta);
    text-decoration: none;
    /* UX-DR22 — zona de toque de 44px. */
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
  }

  .marca:hover {
    text-decoration: underline;
  }

  /*
   * Los tres enlaces se parten en otra fila si no caben, con `--unidad` entre filas. El primero
   * se retranquea su relleno para que su texto quede alineado con el de la marca.
   *
   * El retranqueo sigue desde 600px: en la fila única no se ve —la navegación va al borde derecho
   * por `space-between`, y el margen negativo del lado de entrada no la mueve—, y si el texto
   * ampliado la parte bajo la marca, su «Autores» vuelve a alinearse con el texto de la marca en
   * vez de quedar 8px a la derecha.
   */
  .principal {
    display: flex;
    flex-wrap: wrap;
    row-gap: var(--unidad);
    margin: 0;
    margin-inline-start: calc(-1 * var(--unidad));
    padding: 0;
    list-style: none;
  }

  .principal li {
    display: flex;
    align-items: center;
  }

  /*
   * UX-DR102, UX-DR105 — cuerpo `body-md`, zona de toque de 44 × 44 como mínimo y `--unidad` de
   * relleno lateral. Subrayados siempre, porque comparten línea con los puntos medios, que no
   * enlazan: «Autores» y «Obras» en tinta (`.enlace-en-tinta`, son navegación que informa) y
   * «Buscar» en siena, porque actúa.
   */
  .principal a {
    font-size: var(--cuerpo-md);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--zona-de-toque);
    min-width: var(--zona-de-toque);
    padding-inline: var(--unidad);
  }

  /*
   * Historia 22.10 — «Buscar» va subrayado siempre (UX-DR52): en móvil no hay cursor que pase por
   * encima. La marca, enlace de bloque, conserva el subrayado solo al pasar el cursor.
   */
  .buscar {
    color: var(--siena);
    text-decoration-line: underline;
  }

  /*
   * El punto medio es el `--unidad` entre zonas: de ese ancho, centrado, en tinta apagada y al
   * cuerpo de los enlaces que separa (el del `body` es `--cuerpo-lg`).
   */
  .punto {
    flex: none;
    width: var(--unidad);
    text-align: center;
    font-size: var(--cuerpo-md);
    color: var(--tinta-apagada);
  }

  @media (min-width: 600px) {
    .cabecera {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--unidad) var(--canal);
      padding-block: calc(var(--unidad) * 2);
    }

    .marca {
      align-self: center;
    }
  }

  .pie {
    margin-top: calc(var(--respiracion) * 2);
    padding-block: calc(var(--unidad) * 3);
    border-top: var(--grosor-filete) solid var(--filete);
    color: var(--tinta-apagada);
    font-size: var(--pie);
  }

  .pie p {
    margin: 0;
  }
</style>
