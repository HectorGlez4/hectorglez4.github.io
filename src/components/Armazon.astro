---
/**
 * Armazón común de todas las superficies públicas.
 *
 * UX-DR29 — la cabecera lleva solo la marca y el acceso a la búsqueda. Sin migas de pan,
 * porque no hay jerarquía que reflejar: el visitante entra por una hoja y se mueve
 * lateralmente entre hojas a través de Autor y Tema.
 *
 * NFR-2 — el contenido llega en el HTML inicial. AD-6 — la página no envía JavaScript.
 */
import { Font } from 'astro:assets';
import Medicion from './Medicion.astro';
import { MARCA } from '../lib/marca.ts';
import '../styles/tokens.css';

interface Props {
  titulo: string;
  /** Qué tipo de resultado es esta página en la búsqueda: cita, autor o tema. */
  tipo?: 'cita' | 'autor' | 'tema';
  /** La Página de Cita emite además el evento de vista (AD-13, SM-2). */
  vistaDeCita?: boolean;
  descripcion: string;
  /** Ruta de la página, sin dominio. Compone la canónica de NFR-1. */
  ruta: string;
  /** Páginas 2+ de un listado: rastreables pero no indexables (FR-5). */
  noIndexar?: boolean;
  /**
   * Fuera del índice de la búsqueda propia.
   *
   * `noIndexar` habla con el buscador de fuera; esto habla con el de dentro, y no son lo
   * mismo: `/buscar` es una superficie pública que se declara `noindex` y sigue siendo
   * parte del sitio. Lo que sale del índice es lo que **no es una superficie**, como el
   * Kit Diario: sin esto, una herramienta sin enlaces entrantes aparecía igualmente entre
   * los resultados y dejaba de ser privada por la puerta de atrás.
   */
  fueraDeLaBusqueda?: boolean;
}

const {
  titulo,
  descripcion,
  ruta,
  noIndexar = false,
  fueraDeLaBusqueda = false,
  vistaDeCita = false,
  tipo,
} = Astro.props;
const canonica = new URL(ruta, Astro.site).href;
---

<!doctype html>
<!-- UX-DR27 — idioma `es` sin variante regional. -->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--fuente-serif" preload />
    <Font cssVariable="--fuente-sans" preload />
    <slot name="cabeza" />
    <Medicion vistaDeCita={vistaDeCita} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido.</a>

    <header class="cabecera contenedor">
      <a class="marca" href="/">{MARCA}</a>
      <a class="buscar" href="/buscar">Buscar</a>
    </header>

    {/*
      * Pagefind indexa solo lo que hay dentro de `data-pagefind-body`. Sin esto indexaba
      * también la cabecera y el pie, y buscar «sabiduría» devolvía las 53 páginas del
      * sitio porque la marca aparece en todas.
      */}
    <main
      id="contenido"
      data-pagefind-body={fueraDeLaBusqueda ? undefined : true}
      data-pagefind-ignore={fueraDeLaBusqueda ? true : undefined}
      data-pagefind-meta={tipo ? `tipo:${tipo}` : undefined}
    >
      <slot />
    </main>

    <footer class="pie contenedor">
      <p>
        Citas de dominio público, con su procedencia documentada cuando consta.
      </p>
    </footer>
  </body>
</html>

<style>
  /*
   * UX-DR24 — el orden de tabulación es el orden de lectura. El enlace de salto va
   * primero en el marcado y solo se ve al recibir foco: sin él, quien navega con teclado
   * recorre la cabecera entera en cada página antes de llegar a la Cita.
   */
  .saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--papel);
    color: var(--siena);
    padding: var(--unidad) calc(var(--unidad) * 2);
    z-index: 1;
  }

  .saltar:focus {
    left: var(--margen);
  }

  /* El ancho y el margen lateral vienen de `.contenedor`, compartido con el resto. */
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--canal);
    padding-block: calc(var(--unidad) * 2);
    /* UX-DR13 — el filete de 1px es el único separador del sistema. */
    border-bottom: var(--grosor-filete) solid var(--filete);
  }

  .marca {
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta);
    text-decoration: none;
    /* UX-DR22 — zona de toque de 44px. */
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
  }

  .buscar {
    font-size: var(--cuerpo-md);
    color: var(--siena);
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: var(--zona-de-toque);
    padding-inline: var(--unidad);
  }

  .marca:hover,
  .buscar:hover {
    text-decoration: underline;
  }

  .pie {
    margin-top: calc(var(--respiracion) * 2);
    padding-block: calc(var(--unidad) * 3);
    border-top: var(--grosor-filete) solid var(--filete);
    color: var(--tinta-apagada);
    font-size: var(--pie);
  }

  .pie p {
    margin: 0;
  }
</style>
