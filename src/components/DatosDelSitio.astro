---
/**
 * Datos estructurados de la portada — el sitio como entidad.
 *
 * `WebSite` es lo que permite a un buscador tratar las 252 Páginas de Cita como partes de
 * una obra con nombre en vez de como 252 documentos sueltos que comparten dominio. La
 * `Quotation` de cada Cita ya declara qué es cada hoja; esto declara de qué son hojas.
 *
 * Se emite como `application/ld+json`, que no es JavaScript ejecutable: no lo descarga ni
 * lo ejecuta el navegador, así que no toca AD-6. Es la misma vía que
 * `DatosEstructurados.astro`.
 *
 * ── Lo que deliberadamente no lleva ──────────────────────────────────────────────────
 *
 * `potentialAction` / `SearchAction`. La caja de búsqueda de enlaces de sitio que ese
 * marcado alimentaba la retiró Google en noviembre de 2024, así que hoy no lo lee nadie.
 * `/buscar?q=` funciona de verdad —la búsqueda se ejecuta al cargar con la consulta en la
 * URL—, de modo que declararlo no sería mentira; sería peor: sería marcado inerte, y en
 * este repositorio solo se declara lo que consta **y** lo que sirve.
 *
 * `publisher`. Detrás no hay ni organización ni persona jurídica que nombrar, y una
 * `Organization` inventada para rellenar el hueco es exactamente la procedencia inferida
 * que FR-2 prohíbe, con el agravante de que un buscador se la creería.
 */
import { MARCA } from '../lib/marca.ts';

interface Props {
  descripcion: string;
}

const { descripcion } = Astro.props;

/*
 * La canónica se deriva aquí y no llega por propiedad, por dos razones.
 *
 * La primera es que no hay nada que decidir: este componente describe el sitio, y el sitio
 * es su origen. Una propiedad ofrecería a quien lo use la posibilidad de pasar otra cosa,
 * y no hay otra cosa correcta que pasar.
 *
 * La segunda es una prueba que conviene no romper: `andamiaje.test.ts` exige que
 * `src/pages/index.astro` no contenga la palabra «Astro», que es como comprueba que la
 * portada es la propia y no la de ejemplo del andamiaje. Componer la URL en la portada
 * pedía `Astro.site` allí y ponía esa prueba en rojo por un motivo que no es el suyo.
 */
const canonica = new URL('/', Astro.site).href;

const datos = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': canonica,
  url: canonica,
  name: MARCA,
  description: descripcion,
  inLanguage: 'es',
};
---

<script type="application/ld+json" set:html={JSON.stringify(datos)} is:inline />
