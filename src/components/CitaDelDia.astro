---
/**
 * La Cita del Día — Historia 26.8, AD-12.
 *
 * El bloque que la portada y el 404 pintan con la Cita que toca hoy: su rótulo, el Bloque de
 * Cita y «Ver esta cita». La **selección** sigue en cada página —la jornada la leen ellas, y
 * así lo vigila la guarda de `tests/unit/peso.test.ts`—; aquí solo se pinta lo seleccionado.
 *
 * Lo que pinta cambia de un día a otro sin ningún commit, así que va dentro de `LoQueRota.astro`,
 * el único emisor de la marca de lo que rota (Historia 28.3): el grafo de NFR-5 y la prueba de dos
 * jornadas se saltan ese subárbol, y la portada y el 404 solo pueden diferir ahí. Hasta la 28.3 la
 * marca la ponía este componente; desde que las Obras de la portada también rotan, la pone uno sin
 * otro trabajo, que usan los dos bloques, y este no la nombra (lo exige
 * `tests/unit/alcance-construido.test.ts`).
 *
 * Fuera de Pagefind, por `LoQueRota.astro`: la Cita del Día ya tiene su página en el índice propio.
 * El margen sobre el bloque lo pone cada página, que es quien sabe qué tiene encima.
 */
import BloqueDeCita from './BloqueDeCita.astro';
import LoQueRota from './LoQueRota.astro';
import type { Autor, Cita } from '../lib/publicado.ts';
import { rutaDeCita } from '../lib/superficies.ts';

interface Props {
  cita: Cita;
  autor: Autor;
}

const { cita, autor } = Astro.props;
---

<LoQueRota como="section" class="del-dia">
  <h2>La cita de hoy</h2>
  <BloqueDeCita cita={cita} autor={autor} />
  {/* Historia 23.7 — la Zona de salida interna va en el contenedor del enlace. */}
  <p class="ir" data-zona="cita-del-dia">
    <a href={rutaDeCita(cita.slug)}>Ver esta cita</a>
  </p>
</LoQueRota>

<style>
  h2 {
    margin: 0 0 calc(var(--unidad) * 3);
    font-family: var(--sans);
    font-size: var(--autor);
    font-weight: var(--peso-fuerte);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinta-apagada);
  }

  .ir {
    margin: calc(var(--unidad) * 3) 0 0;
    font-size: var(--cuerpo-md);
  }
</style>
