---
/**
 * Isla de compartir enlace — FR-18.
 *
 * Los destinos se componen **en el build** y salen en el marcado como enlaces de verdad.
 * De ahí vienen tres propiedades a la vez: funcionan con JavaScript desactivado, no hay
 * código que construya direcciones en el cliente, y el guion se queda en las pocas líneas
 * que cambian una lista por un botón.
 *
 * Lo que hay que saber al leer el manejador, escrito aquí porque los comentarios de un
 * `is:inline` viajan al visitante y la Página de Cita tiene presupuesto de bytes:
 *
 *   · La comprobación es `navigator.share` a secas, y **no** `canShare({files})` como en
 *     la Imagen. Son capacidades distintas y hace falta la contraria: aquí se manda texto
 *     y enlace, que es justo lo que sabe hacer el navegador que no admite ficheros.
 *   · Con hoja del sistema se esconde la lista y se enseña el botón. Sin ella la lista ya
 *     está ahí, visible y con destinos concretos — que es lo que pide el criterio, en vez
 *     de un control deshabilitado o un aviso de incompatibilidad.
 *   · Historia 22.10 — cada destino dice «Compartir en {destino}» y avisa de la pestaña
 *     nueva dentro de su nombre accesible, con el patrón de «Apoyar el sitio».
 *   · Cancelar la hoja no es un fallo y no se registra. Ver la nota de `ImagenDeCita`.
 *   · FR-20 — cada destino concreto se registra con su nombre, que es lo que responde
 *     «hacia dónde»; la hoja del sistema se registra como `opaco`, porque la Web Share
 *     API no dice adónde fue y no se intenta averiguarlo. El oyente de los destinos es
 *     uno solo, delegado en la isla: uno por enlace costaba bytes de guion, y la Página
 *     de Cita tiene presupuesto.
 *
 * El guion no lleva su propio `(() => { … })()`: `define:vars` ya lo envuelve en una
 * función, y el envoltorio repetido eran dos espacios de sangría por línea en el
 * presupuesto de bytes (Historia 22.10). Tampoco pregunta si su marcado existe: el guion lo
 * emite este mismo componente justo detrás, bajo la misma condición, y el compilador no
 * admite un `return` fuera de función. Quitarle `define:vars` obligaría a devolverle el
 * envoltorio.
 */
import { AVISO_DE_PESTAÑA_NUEVA } from '../lib/accesibilidad.ts';
import {
  DESTINO_OPACO,
  DESTINOS,
  rotuloDeDestino,
  textoParaCompartir,
} from '../lib/compartir.ts';
import { EVENTOS } from '../lib/medicion.ts';
import type { Cita, Autor } from '../lib/publicado.ts';

interface Props {
  cita: Cita;
  autor: Autor;
  /** La canónica, absoluta: es lo que se comparte y lo único que el buscador indexa. */
  canonica: string;
}

const { cita, autor, canonica } = Astro.props;
const texto = textoParaCompartir(cita, autor);
---

<div class="isla" data-pagefind-ignore data-compartir data-texto={texto} data-url={canonica}>
  <button type="button" class="hoja" data-hoja hidden>Compartir la cita</button>

  <ul class="destinos" data-destinos>
    {
      DESTINOS.map((destino) => (
        <li>
          <a
            href={destino.enlace(texto, canonica)}
            data-destino={destino.id}
            target="_blank"
            rel="noopener noreferrer"
          >
            {rotuloDeDestino(destino)}<span class="solo-para-lectores">{AVISO_DE_PESTAÑA_NUEVA}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script
  is:inline
  define:vars={{ EVENTO_COMPARTICION: EVENTOS.comparticionDeEnlace, DESTINO_OPACO }}>
  const isla = document.querySelector('[data-compartir]');
  isla.addEventListener('click', (evento) => {
    const destino = evento.target.closest('[data-destino]');
    if (destino) window.__medir && window.__medir(EVENTO_COMPARTICION, null, destino.dataset.destino);
  });

  if (navigator.share) {
    const boton = isla.querySelector('[data-hoja]');
    isla.querySelector('[data-destinos]').hidden = true;
    boton.hidden = false;

    boton.addEventListener('click', async () => {
      try {
        await navigator.share({ text: isla.dataset.texto, url: isla.dataset.url });
        window.__medir && window.__medir(EVENTO_COMPARTICION, null, DESTINO_OPACO);
      } catch {}
    });
  }
</script>

<style>
  .isla {
    margin-top: calc(var(--unidad) * 2);
  }

  .destinos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--unidad);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* UX-DR9 — secundario con filete; UX-DR22 — 44px de zona de toque. */
  .destinos a,
  .hoja {
    display: flex;
    align-items: center;
    font-family: var(--sans);
    font-size: var(--cuerpo-md);
    color: var(--siena);
    background: transparent;
    border: var(--grosor-filete) solid var(--siena);
    border-radius: var(--radio);
    min-height: var(--zona-de-toque);
    padding-inline: calc(var(--unidad) * 3);
    text-decoration: none;
    cursor: pointer;
  }

  .destinos a:hover,
  .hoja:hover {
    background: var(--siena);
    color: var(--sobre-siena);
  }

  /*
   * `display: flex` gana al `display: none` que el navegador da por defecto a `[hidden]`,
   * así que sin esto el botón de la hoja y la lista se veían **los dos a la vez**: el
   * atributo estaba puesto y no hacía nada. Lo destapó la prueba, no la vista.
   */
  .destinos[hidden],
  .hoja[hidden] {
    display: none;
  }
</style>
