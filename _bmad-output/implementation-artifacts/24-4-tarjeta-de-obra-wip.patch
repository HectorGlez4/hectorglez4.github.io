@@ -0,0 +1,129 @@
+---
+/**
+ * Tarjeta de Obra — FR-12, UX-DR64, UX-DR104, UX-DR108, UX-DR110, Historia 24.4.
+ *
+ * Lo que la Página de Cita dice de la Obra de la que sale su Cita, justo debajo de la Línea de
+ * la Fuente —o de la Atribución, sin Fuente— y antes de Copiar. Quien llega desde un buscador ve
+ * de qué libro es la frase, cuántas citas hay de él y que puede ir a la Obra y a dónde leerla,
+ * sin buscarlo dentro de la línea de la Procedencia.
+ *
+ *   · Rótulo «De la obra», con el nivel que recibe (`nivel`, sin valor por omisión): la Página de
+ *     Cita pasa `2`; la portada pasará `3`, bajo «La cita de hoy» (28.2).
+ *   · El título de su Ficha de Obra, sin enlace —ya enlaza en la Atribución, y aquí lo hace la
+ *     fila— y sin recortar nunca (NFR-12).
+ *   · «{Autor} · {año} · {n} citas»: lo compone `contenidoDeTarjetaDeObra`, en
+ *     `src/lib/atribucion.ts`, con el año y el recuento de la Obra resuelta. Aquí no se cuenta
+ *     ni se deriva nada (AD-11).
+ *   · Una Fila de bloque a la página 1 de la Obra —se indexe o no, esté congelada o no: el
+ *     `noindex` y la congelación no alcanzan a la navegación—, que promete «y dónde leerla» solo
+ *     si alguna de sus Citas está cotejada (`edicionCotejada`). Las `ediciones` de la ficha y la
+ *     afiliación no cuentan: la tarjeta sale idéntica byte a byte con el Modelo encendido o
+ *     apagado (FR-35), y no aloja ninguno.
+ *
+ * Sin Obra no pinta nada —ni sección, ni rótulo, ni hueco—, como `Fuente.astro` sin Fuente.
+ *
+ * **No vive dentro de `BloqueDeCita.astro`** porque ese bloque lo comparten la portada y el
+ * 404, y ninguna de las dos cambia con esta historia: la portada la recibe en la 28.2, con su
+ * propio nivel, y el 404 no la lleva nunca.
+ *
+ * Fuera de Pagefind con `all` y no con el atributo a secas: la tarjeta nombra el título y el
+ * Autor, que el índice no debe recoger ni como texto ni como filtro desde cada Página de Cita
+ * (NFR-13). Sin guion: todo sale del build.
+ */
+import Rotulo from './Rotulo.astro';
+import FilaDeBloque from './FilaDeBloque.astro';
+import type { Cita, Autor } from '../lib/publicado.ts';
+import { rutaDeLaObra } from '../lib/obras.ts';
+import { contenidoDeTarjetaDeObra } from '../lib/atribucion.ts';
+
+interface Props {
+  cita: Cita;
+  /** El Autor de la Cita: el que declara `cita.autor`, y ningún otro. */
+  autor: Autor;
+  /**
+   * El nivel del rótulo «De la obra». Obligatorio y sin valor por omisión: depende de bajo qué
+   * encabezado cuelga la tarjeta, y eso solo lo sabe quien la usa.
+   */
+  nivel: 2 | 3;
+}
+
+const { cita, autor, nivel } = Astro.props;
+
+/*
+ * Que la Tarjeta nombre al Autor de otro sería atribuirle la Obra a quien no la firma. La
+ * integridad del conjunto publicable garantiza que toda Cita resuelve su Autor, así que esto es
+ * un uso roto, no un caso que pintar: detiene la construcción.
+ */
+if (autor.slug !== cita.autor) {
+  throw new Error(
+    `TarjetaDeObra: la Cita «${cita.slug}» se pinta en ${Astro.url.pathname} con el Autor ` +
+      `«${autor.slug}», pero la Cita declara «${cita.autor}».`,
+  );
+}
+
+const obra = cita.obra;
+const contenido = obra === undefined ? undefined : contenidoDeTarjetaDeObra(autor, obra);
+---
+
+{/*
+  * Las partes de los hechos van pegadas, sin espacio entre etiquetas: Astro conserva uno donde
+  * hay salto de línea, y la vista diría «Séneca  · 49». El punto medio es decoración y el lector
+  * oye una coma; ninguno al principio ni al final, y ninguno de sobra cuando falta el año.
+  */}
+{
+  obra !== undefined && contenido !== undefined && (
+    <section class="tarjeta-de-obra" aria-labelledby="de-la-obra" data-pagefind-ignore="all">
+      <Rotulo id="de-la-obra" nivel={nivel}>De la obra</Rotulo>
+      <p class="titulo">{obra.titulo}</p>
+      <p class="hechos">{contenido.hechos.map((parte, i) => (<>{i > 0 && (<><span aria-hidden="true"> · </span><span class="solo-para-lectores">, </span></>)}{parte}</>))}</p>
+      <ul class="filas"><FilaDeBloque href={rutaDeLaObra(obra)} zona="tarjeta-de-obra" flecha>{contenido.fila}</FilaDeBloque></ul>
+    </section>
+  )
+}
+
+<style>
+  /*
+   * Plana y en tinta (variante 1A): la delimitan el filete de arriba y su rótulo, como las Rutas
+   * de salida. Ni fondo, ni radio, ni siena: un fondo sería el primero de la Página de Cita.
+   */
+  .tarjeta-de-obra {
+    margin-top: calc(var(--unidad) * 4);
+    border-top: var(--grosor-filete) solid var(--filete);
+    padding-top: calc(var(--unidad) * 3);
+    max-width: var(--medida-prosa);
+  }
+
+  /*
+   * Inter, nunca la serif: el título de una Obra no es nombre de Autor ni de Tema. Sin segundo
+   * tamaño ni máximo de líneas: un título largo reparte sus líneas y parte palabras antes que
+   * desbordar, con la partición del `h1` de la Cabecera de Obra.
+   */
+  .titulo {
+    margin: var(--unidad) 0 0;
+    font-family: var(--sans);
+    font-size: var(--cuerpo-lg);
+    font-weight: 600;
+    line-height: 1.4;
+    color: var(--tinta);
+    text-wrap: balance;
+    overflow-wrap: break-word;
+    hyphens: auto;
+  }
+
+  .hechos {
+    margin: var(--unidad) 0 0;
+    font-family: var(--sans);
+    font-size: var(--pie);
+    font-weight: 400;
+    line-height: 1.5;
+    color: var(--tinta-apagada);
+  }
+
+  /* El filete de encima de la primera fila; el de debajo de cada una lo pone la fila. */
+  .filas {
+    list-style: none;
+    margin: calc(var(--unidad) * 2) 0 0;
+    padding: 0;
+    border-top: var(--grosor-filete) solid var(--filete);
+  }
+</style>
