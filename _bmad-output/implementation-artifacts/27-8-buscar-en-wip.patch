+  expect(etiqueta, ruta).not.toBeNull();
+  expect(texto(etiqueta![2]), ruta).toBe(rotulo);
+  const campos = [...formulario.matchAll(/<input\b[^>]*>/g)].map((m) => m[0]);
+  const campo = campos.find((c) => /\bname="q"/.test(c));
